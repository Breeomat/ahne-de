---
import '../styles/global.css';
import { url, person } from '../lib/site';
import { seiten, ui, type Seite, type Sprache } from '../lib/sprache';

interface Props {
  sprache?: Sprache;
  // Seitenpaar für den Sprachumschalter; ohne Angabe (404) springt er auf die Startseiten
  seite?: Seite;
  titel?: string;
  beschreibung?: string;
  // schlicht: ohne Modern-Darstellung (helle, ruhige Grundgestaltung); verborgen: nicht für Suchmaschinen
  schlicht?: boolean;
  verborgen?: boolean;
}

const { sprache = 'de', seite = 'start', titel, beschreibung = ui[sprache].beschreibung, schlicht = false, verborgen = false } = Astro.props;
const t = ui[sprache];
const seitentitel = titel ? `${titel} · ${person.name}` : person.name;
const kanonisch = new URL(Astro.url.pathname, Astro.site).href;
const fehlerseite = Astro.url.pathname.startsWith(url('404'));
const fassungen = (['de', 'en'] as const).map((s) => ({ sprache: s, href: url(seiten[seite][s]) }));
// Strukturierte Daten (schema.org) für Suchmaschinen: wer hinter der Seite steht
const strukturiert = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  address: { '@type': 'PostalAddress', addressLocality: 'Herbstein-Stockhausen', addressCountry: 'DE' },
  url: new URL(url(seiten.start[sprache]), Astro.site).href,
};
---
<!doctype html>
<html lang={sprache} data-stil={schlicht ? undefined : 'modern'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    <meta name="theme-color" content="#2f4a3a" />
    <!-- Ortsschild „Marc Ahne“ (public/favicon.svg, PNG-Fassungen daraus erzeugt) -->
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={url('favicon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:type" content="website" />
    <meta name="author" content={person.name} />
    {fehlerseite || verborgen ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={kanonisch} />}
    {!fehlerseite && fassungen.map((f) => <link rel="alternate" hreflang={f.sprache} href={new URL(f.href, Astro.site).href} />)}
    {!fehlerseite && <link rel="alternate" hreflang="x-default" href={new URL(fassungen[0].href, Astro.site).href} />}
    {!fehlerseite && <script type="application/ld+json" set:html={JSON.stringify(strukturiert)} />}
    <!-- Ankunft per Transmitter (Sprachwechsel): Seite bis zum Effekt verbergen, damit nichts aufblitzt -->
  </head>
  <body>
    <header class="kopf huelle">
      <nav class="sprachen" aria-label={t.sprachwahl}>
        {fassungen.map((f) => (
          <a data-sprache-wechsel href={f.href} hreflang={f.sprache} lang={f.sprache} aria-current={f.sprache === sprache ? 'true' : undefined}>
            {f.sprache === 'de' ? 'Deutsch' : 'English'}
          </a>
        ))}
      </nav>
    </header>
    <main id="inhalt" class="huelle">
      <slot />
    </main>
    <footer class="fuss">
      <div class="huelle">
        <span>© {new Date().getFullYear()} {person.name}</span>
        <nav aria-label={t.rechtliches}>
          <a href={url(seiten.impressum[sprache])}>{t.impressum}</a>
          <a href={url(seiten.datenschutz[sprache])}>{t.datenschutz}</a>
        </nav>
      </div>
    </footer>
    <script>
      // Sprachwechsel: auf der Startseite fliegt die Drohne erst nach England bzw. Deutschland (Drohnenflug.astro),
      // auf allen anderen Seiten geht der Link ganz normal
      document.querySelectorAll<HTMLAnchorElement>('a[data-sprache-wechsel]:not([aria-current])').forEach((a) =>
        a.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
          const reise = new CustomEvent('drohne:reise', { cancelable: true, detail: { nach: a.hreflang, weiter: () => (location.href = a.href) } });
          if (!dispatchEvent(reise)) e.preventDefault();
        }),
      );
    </script>
    <script is:inline>
      // Lichtkegel folgt der Maus
      addEventListener('pointermove', (e) => {
        document.documentElement.style.setProperty('--mx', e.clientX + 'px');
        document.documentElement.style.setProperty('--my', e.clientY + 'px');
      }, { passive: true });
    </script>
  </body>
</html>
