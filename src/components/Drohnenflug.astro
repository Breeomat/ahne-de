---
// Drohnenflug (nur Darstellung „Modern“, Startseite): Beim Scrollen fliegt die Kamera über Stockhausen,
// von der Altfellhalle übers Dorf bis zur Übersicht. Karte: public/drohne/stockhausen.svg (scripts/drohnenkarte.py),
// wird erst geladen, wenn „Modern“ aktiv ist. Kartendaten © OpenStreetMap-Mitwirkende.
import { url } from '../lib/site';
import korsika from '../lib/korsika-rahmen.json';
import type { Sprache } from '../lib/sprache';

interface Props {
  sprache: Sprache;
}

const { sprache } = Astro.props;
const de = sprache === 'de';

// Ziel des Flugs: Mühlweg 11a (Wunsch des Seiteninhabers). In OSM steht nur Nr. 11 – leuchten lassen wir
// das Gebäude dort samt Anbau (Umrisse aus der Grundkarte).
const zuhause = {
  x: 655.5,
  y: 368.2,
  umriss: 'M653.5,363.3 653.6,373 648.3,373.1 648.2,363.3ZM654.2,367.5 660.9,367.2 661,370.9 654.4,371.2Z',
};

// Flugroute in Kartenkoordinaten (0–1000 × 0–853, siehe Rahmen); p = Anteil der Seite, z = Zoom, kurs in Grad
const route = [
  { p: 0, x: 817.5, y: 429.5, z: 5, kurs: 285, ort: de ? 'Sportplatz · Altfellhalle' : 'Sports ground · Altfellhalle' },
  { p: 0.18, x: 675.2, y: 380, z: 4.5, kurs: 300, ort: de ? 'Gefrierhaus' : 'Freezer house' },
  { p: 0.34, x: 600, y: 343.4, z: 4, kurs: 295, ort: de ? 'Feuerwehrhaus' : 'Fire station' },
  { p: 0.5, x: 480, y: 289.9, z: 3.4, kurs: 320, ort: de ? 'Schloss Stockhausen' : 'Stockhausen castle' },
  { p: 0.64, x: 535.7, y: 244.7, z: 2.8, kurs: 25, ort: de ? 'Ev. Kirche' : 'Church' },
  { p: 0.82, x: 579, y: 349.9, z: 1, kurs: 0, ort: de ? 'Stockhausen von oben' : 'Stockhausen from above' },
  { p: 1, x: zuhause.x, y: zuhause.y, z: 4.2, kurs: 0, ort: de ? 'Ziel · Mühlweg 11a' : 'Destination · Mühlweg 11a' },
];
const rahmen = { west: 9.4325, sued: 50.555, ost: 9.4565, nord: 50.568, breite: 1000, hoehe: 853 };
const status = de ? ['STARTBEREIT', 'IM FLUG', 'ZIEL ERREICHT'] : ['READY', 'IN FLIGHT', 'DESTINATION REACHED'];
// Einsatz 112 (Überraschung): Drohne fliegt zum Feuerwehrhaus
const einsatz = { x: 600, y: 343.4, ort: de ? 'Feuerwehrhaus · Einsatz' : 'Fire station · callout', alarm: 'ALARM', vorOrt: de ? 'IM EINSATZ' : 'ON SCENE' };
// Tageszeit (src/scripts/tageszeit.ts): Texte fürs Live-Protokoll
const licht = de
  ? {
      nacht: 'Lichtverhältnisse: Nacht über Stockhausen. Die Straßenlaternen brennen, in einzelnen Häusern ist noch Licht.',
      daemmerung: 'Lichtverhältnisse: Dämmerung. Die Straßenlaternen gehen an.',
      morgen: 'Lichtverhältnisse: Morgen. Über dem Bach liegt Nebel.',
      tag: 'Lichtverhältnisse: Tag. Gute Sicht für die Drohne.',
      abend: 'Lichtverhältnisse: Abendsonne. Das Dorf liegt im goldenen Licht.',
    }
  : {
      nacht: 'Light conditions: night over Stockhausen. The street lamps are on, a few houses still have their lights on.',
      daemmerung: 'Light conditions: twilight. The street lamps are coming on.',
      morgen: 'Light conditions: morning. Mist lies over the brook.',
      tag: 'Light conditions: daylight. Good visibility for the drone.',
      abend: 'Light conditions: evening sun. The village is bathed in golden light.',
    };
// Urlaub (Überraschung): Drohne fliegt über Korsika (Karte public/drohne/korsika.svg aus scripts/korsikakarte.mjs).
// t = Sekunden ab Start, z = Zoom (1 = ganze Insel)
const o = korsika.orte;
const urlaub = {
  quelle: url('drohne/korsika.svg'),
  rahmen: { west: korsika.west, sued: korsika.sued, ost: korsika.ost, nord: korsika.nord, breite: korsika.breite, hoehe: korsika.hoehe },
  status: de ? 'URLAUB' : 'HOLIDAY',
  route: [
    { t: 0, x: 500, y: 916, z: 1, ort: de ? 'Korsika von oben' : 'Corsica from above' },
    { t: 2.2, x: o['Bastia'][0], y: o['Bastia'][1], z: 2.6, ort: 'Bastia' },
    { t: 4, x: o['Saint-Florent'][0], y: o['Saint-Florent'][1], z: 2.8, ort: 'Saint-Florent' },
    { t: 6, x: o['Calvi'][0], y: o['Calvi'][1], z: 2.6, ort: 'Calvi' },
    { t: 8, x: 438, y: 663, z: 1.9, ort: 'Monte Cinto · 2706 m' },
    { t: 10, x: o['Ajaccio'][0], y: o['Ajaccio'][1], z: 2.6, ort: 'Ajaccio' },
    { t: 12.5, x: o['Bonifacio'][0], y: o['Bonifacio'][1], z: 2.8, ort: 'Bonifacio' },
    { t: 14, x: o['Porto-Vecchio'][0], y: o['Porto-Vecchio'][1], z: 2.6, ort: 'Porto-Vecchio' },
    { t: 16.5, x: 500, y: 916, z: 1, ort: de ? 'Korsika von oben' : 'Corsica from above' },
  ],
};
const kompass = ['N', 'NO', 'O', 'SO', 'S', 'SW', 'W', 'NW'].map((r) => (de ? r : r.replace('O', 'E')));
---
<div class="drohne" aria-hidden="true" data-quelle={url('drohne/stockhausen.svg')} data-route={JSON.stringify(route)} data-rahmen={JSON.stringify(rahmen)} data-status={JSON.stringify(status)} data-zuhause={JSON.stringify(zuhause)} data-einsatz={JSON.stringify(einsatz)} data-licht={JSON.stringify(licht)} data-urlaub={JSON.stringify(urlaub)}>
  <div class="drohne__karte"></div>
  <div class="drohne__urlaub"></div>
  <div class="drohne__sterne"></div>
  <div class="drohne__fadenkreuz"></div>
</div>
<div class="drohne-hud" aria-hidden="true">
  <span class="ecke ecke--lo"></span><span class="ecke ecke--ro"></span><span class="ecke ecke--lu"></span><span class="ecke ecke--ru"></span>
  <div class="drohne-hud__seite drohne-hud__seite--links">
    <span>ALT</span><b data-hud="hoehe">0</b><small>m</small>
    <span>SPD</span><b data-hud="tempo">0.0</b><small>m/s</small>
  </div>
  <div class="drohne-hud__seite drohne-hud__seite--rechts">
    <span>HDG</span><b data-hud="kurs">000</b><small>°</small>
    <span>BAT</span><b data-hud="akku">100</b><small>%</small>
    <span>SUN</span><b data-hud="sonne">–</b><small>°</small>
  </div>
  <div class="drohne-hud__leiste">
    <span class="rec"><i></i>REC <span data-hud="zeit">00:00</span></span>
    <span class="nur-breit" data-hud="status">{status[0]}</span>
    <span class="nur-schmal">ALT <span data-hud="hoehe2">0</span> m</span>
    <span class="kompass nur-breit"><span data-hud="kompass">{[0, 1, 2].map(() => kompass.map((r) => <i>{r}</i>))}</span></span>
    <span class="ort"><span data-hud="ort">{route[0].ort}</span><span class="nur-breit" data-hud="gps"></span></span>
  </div>
</div>

<script>
  import { sonne, phase, type Phase } from '../scripts/tageszeit';
  const wurzel = document.documentElement;
  const ebene = document.querySelector<HTMLElement>('.drohne')!;
  const flaeche = ebene.querySelector<HTMLElement>('.drohne__karte')!;
  const hud: Record<string, HTMLElement> = {};
  document.querySelectorAll<HTMLElement>('[data-hud]').forEach((el) => (hud[el.dataset.hud!] = el));

  type Punkt = { p: number; x: number; y: number; z: number; kurs: number; ort: string };
  const route: Punkt[] = JSON.parse(ebene.dataset.route!);
  const rahmen = JSON.parse(ebene.dataset.rahmen!);
  const status: string[] = JSON.parse(ebene.dataset.status!);
  const zMax = route[0].z;
  const einsatzZiel = JSON.parse(ebene.dataset.einsatz!);
  // Überraschungen (src/components/Ueberraschungen.astro) steuern die Drohne über Ereignisse
  let einsatz: number | null = null;
  let looping: number | null = null;
  let letzterOrt = '';
  let zielGemeldet = false;
  addEventListener('drohne:einsatz', () => { einsatz = performance.now(); planen(); });
  addEventListener('drohne:looping', () => { looping = performance.now(); planen(); });

  // ---------- Urlaub: Flug über Korsika (zeitgesteuert, unabhängig vom Scrollen) ----------
  type UPunkt = { t: number; x: number; y: number; z: number; ort: string };
  const urlaubDaten: { quelle: string; rahmen: typeof rahmen; status: string; route: UPunkt[] } = JSON.parse(ebene.dataset.urlaub!);
  const urlaubFlaeche = ebene.querySelector<HTMLElement>('.drohne__urlaub')!;
  let urlaubSvg: SVGSVGElement | null = null;
  let urlaubStart: number | null = null;
  // Kurs je Strecke: Flugrichtung, letzte Strecke zurück nach Norden
  const urlaubKurs = urlaubDaten.route.map((a, i, r) => {
    const b = r[Math.min(i + 1, r.length - 1)];
    return i >= r.length - 2 ? 0 : ((Math.atan2(b.x - a.x, -(b.y - a.y)) * 180) / Math.PI + 360) % 360;
  });
  addEventListener('drohne:urlaub', async () => {
    if (urlaubStart !== null) return;
    if (!urlaubSvg) {
      try {
        const text = await (await fetch(urlaubDaten.quelle)).text();
        urlaubSvg = new DOMParser().parseFromString(text, 'image/svg+xml').documentElement as unknown as SVGSVGElement;
        urlaubFlaeche.append(urlaubSvg);
      } catch {
        return;
      }
    }
    urlaubStart = performance.now();
    ebene.classList.add('im-urlaub');
    planen();
  });

  // zeichnet die Korsika-Kamera und überschreibt die Anzeige; false, wenn der Urlaub vorbei ist
  function urlaubZeichnen(jetzt: number) {
    const r = urlaubDaten.route;
    const t = (jetzt - urlaubStart!) / 1000;
    if (t > r[r.length - 1].t + 0.8) {
      urlaubStart = null;
      ebene.classList.remove('im-urlaub');
      tageszeit();
      dispatchEvent(new CustomEvent('drohne:urlaub-ende'));
      return false;
    }
    let i = 0;
    while (i < r.length - 2 && t > r[i + 1].t) i++;
    const a = r[i], b = r[i + 1];
    const roh = Math.min(1, Math.max(0, (t - a.t) / (b.t - a.t)));
    const k = glatt(roh);
    const x = a.x + (b.x - a.x) * k, y = a.y + (b.y - a.y) * k;
    const z = a.z + (b.z - a.z) * k;
    const kurs = (winkel(urlaubKurs[Math.max(0, i - 1)], urlaubKurs[i], Math.min(1, roh / 0.35)) + 360) % 360;
    const ur = urlaubDaten.rahmen;
    const diag = Math.ceil(Math.hypot(innerWidth, innerHeight));
    const pxJeEinheit = Math.min(innerWidth / ur.breite, innerHeight / ur.hoehe) * 0.95 * z;
    const sicht = diag / pxJeEinheit;
    urlaubSvg!.style.width = urlaubSvg!.style.height = diag + 'px';
    urlaubSvg!.setAttribute('viewBox', `${(x - sicht / 2).toFixed(2)} ${(y - sicht / 2).toFixed(2)} ${sicht.toFixed(2)} ${sicht.toFixed(2)}`);
    // Karte bleibt genordet, damit die Ortsnamen lesbar bleiben; der Kurs steht nur in der Anzeige
    urlaubSvg!.style.transform = 'translate(-50%, -50%)';
    const lat = ur.nord - (y / ur.hoehe) * (ur.nord - ur.sued);
    const lon = ur.west + (x / ur.breite) * (ur.ost - ur.west);
    const hoehe = Math.round(250 + ((2.8 - Math.min(2.8, z)) / 1.8) * 1250);
    hud.hoehe.textContent = hud.hoehe2.textContent = String(hoehe);
    hud.kurs.textContent = String(Math.round(kurs) % 360).padStart(3, '0');
    hud.ort.textContent = (roh < 0.5 ? a : b).ort;
    hud.gps.textContent = `${lat.toFixed(4)} N  ${lon.toFixed(4)} E`;
    hud.status.textContent = urlaubDaten.status;
    hud.sonne.textContent = '☀';
    hud.kompass.style.transform = `translateX(${(-(8 + kurs / 45) * 3.2 + 3.2 * 1.5).toFixed(3)}em)`;
    return true;
  }
  // Meter je Karteneinheit (für die Geschwindigkeit)
  const meterJeEinheit = ((rahmen.ost - rahmen.west) * 111320 * Math.cos(((rahmen.sued + rahmen.nord) / 2) * (Math.PI / 180))) / rahmen.breite;

  let svg: SVGSVGElement | null = null;
  let laedt = false;
  let geplant = false;
  let vorher = { x: route[0].x, y: route[0].y, t: performance.now() };
  let tempo = 0;
  let flugbeginn = performance.now();
  let uhr: number | undefined;

  const modern = () => wurzel.dataset.stil === 'modern';
  const glatt = (t: number) => t * t * (3 - 2 * t);
  const winkel = (a: number, b: number, t: number) => a + ((((b - a) % 360) + 540) % 360 - 180) * t;

  function stelle(p: number) {
    let i = 0;
    while (i < route.length - 2 && p > route[i + 1].p) i++;
    const a = route[i], b = route[i + 1];
    const t = glatt(Math.min(1, Math.max(0, (p - a.p) / (b.p - a.p))));
    return {
      x: a.x + (b.x - a.x) * t,
      y: a.y + (b.y - a.y) * t,
      z: a.z + (b.z - a.z) * t,
      kurs: (winkel(a.kurs, b.kurs, t) + 360) % 360,
      ort: t < 0.5 ? a.ort : b.ort,
    };
  }

  function zeichnen() {
    geplant = false;
    if (!svg || !modern()) return;
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    const s = stelle(p);
    let aktiv = false;
    let statusSonder = '';
    let extraDreh = 0;
    const jetzt0 = performance.now();
    if (einsatz !== null) {
      const t = (jetzt0 - einsatz) / 1000;
      // 0–2,5 s Anflug, bis 7 s vor Ort, bis 9,5 s zurück auf die Route
      const k = t < 2.5 ? glatt(t / 2.5) : t < 7 ? 1 : t < 9.5 ? 1 - glatt((t - 7) / 2.5) : 0;
      s.x += (einsatzZiel.x - s.x) * k;
      s.y += (einsatzZiel.y - s.y) * k;
      s.z += (4.5 - s.z) * k;
      s.kurs = (winkel(s.kurs, 0, k) + 360) % 360;
      if (k > 0.5) s.ort = einsatzZiel.ort;
      if (t < 7) statusSonder = t < 2.5 ? einsatzZiel.alarm : einsatzZiel.vorOrt;
      if (t >= 9.5) {
        einsatz = null;
        dispatchEvent(new CustomEvent('drohne:einsatz-ende'));
      } else aktiv = true;
    }
    if (looping !== null) {
      const t = (jetzt0 - looping) / 1600;
      if (t >= 1) looping = null;
      else {
        aktiv = true;
        extraDreh = glatt(t) * 360;
        s.z *= 1 - 0.35 * Math.sin(Math.PI * t);
      }
    }

    // Kamera: quadratisches SVG mit Bildschirmdiagonale, damit beim Drehen keine Ecken fehlen
    const diag = Math.ceil(Math.hypot(innerWidth, innerHeight));
    const pxJeEinheit = Math.max(innerWidth / rahmen.breite, innerHeight / rahmen.hoehe) * 1.05 * s.z;
    const sicht = diag / pxJeEinheit;
    svg.style.width = svg.style.height = diag + 'px';
    svg.setAttribute('viewBox', `${(s.x - sicht / 2).toFixed(2)} ${(s.y - sicht / 2).toFixed(2)} ${sicht.toFixed(2)} ${sicht.toFixed(2)}`);
    svg.style.transform = `translate(-50%, -50%) rotate(${(-s.kurs - extraDreh).toFixed(2)}deg)`;

    // Anzeige
    const jetzt = performance.now();
    const dt = Math.max(16, jetzt - vorher.t) / 1000;
    const strecke = Math.hypot(s.x - vorher.x, s.y - vorher.y) * meterJeEinheit;
    tempo = tempo * 0.8 + Math.min(18, strecke / dt) * 0.2;
    vorher = { x: s.x, y: s.y, t: jetzt };
    const hoehe = Math.round(4 + ((zMax - s.z) / (zMax - 1)) * 116);
    const lat = rahmen.nord - (s.y / rahmen.hoehe) * (rahmen.nord - rahmen.sued);
    const lon = rahmen.west + (s.x / rahmen.breite) * (rahmen.ost - rahmen.west);
    hud.hoehe.textContent = hud.hoehe2.textContent = String(hoehe);
    hud.tempo.textContent = tempo.toFixed(1);
    hud.kurs.textContent = String(Math.round(s.kurs) % 360).padStart(3, '0');
    hud.akku.textContent = String(Math.round(100 - p * 37));
    hud.ort.textContent = s.ort;
    hud.gps.textContent = `${lat.toFixed(4)} N  ${lon.toFixed(4)} E`;
    hud.status.textContent = statusSonder || (p < 0.02 ? status[0] : p > 0.97 ? status[2] : status[1]);
    // fürs Live-Protokoll: neuer Ort und Ankunft am Ziel melden
    if (s.ort !== letzterOrt) {
      letzterOrt = s.ort;
      if (!statusSonder && s.ort !== route[route.length - 1].ort) dispatchEvent(new CustomEvent('drohne:ort', { detail: s.ort }));
    }
    if (p > 0.97 && !zielGemeldet) {
      zielGemeldet = true;
      dispatchEvent(new CustomEvent('drohne:ziel'));
    }
    // Ziel leuchtet auf, sobald die Drohne zur Landung ansetzt
    ebene.style.setProperty('--naehe', Math.min(1, Math.max(0, (p - 0.72) / 0.2)).toFixed(3));
    // Kompassband: 8 Richtungen à 45°, je 3.2em breit, dreifach hintereinander
    hud.kompass.style.transform = `translateX(${(-(8 + s.kurs / 45) * 3.2 + 3.2 * 1.5).toFixed(3)}em)`;
    if (urlaubStart !== null && urlaubSvg && urlaubZeichnen(performance.now())) aktiv = true;
    if (tempo > 0.2 || aktiv) planen();
  }

  function planen() {
    if (!geplant) {
      geplant = true;
      requestAnimationFrame(zeichnen);
    }
  }

  function uhrStellen() {
    const sek = Math.floor((performance.now() - flugbeginn) / 1000);
    hud.zeit.textContent = `${String(Math.floor(sek / 60)).padStart(2, '0')}:${String(sek % 60).padStart(2, '0')}`;
  }

  // ---------- Tageszeit: Laternen, Fensterlicht, Nebel über dem Bach, Sterne ----------
  // Zum Ausprobieren: ?zeit=nacht|daemmerung|morgen|tag|abend
  const lichtTexte: Record<Phase, string> = JSON.parse(ebene.dataset.licht!);
  const testzeit = new URLSearchParams(location.search).get('zeit') as Phase | null;
  let letztePhase: Phase | null = null;

  function tageszeitAufbauen(karte: SVGSVGElement) {
    const ns = 'http://www.w3.org/2000/svg';
    const neu = (name: string, attr: Record<string, string>) => {
      const el = document.createElementNS(ns, name);
      for (const [k, v] of Object.entries(attr)) el.setAttribute(k, v);
      return el;
    };
    // Bewusst ohne SVG-Filter und ohne Animationen in der Karte: die Kamera zeichnet die Karte bei jedem
    // Scroll-Schritt neu, Weichzeichner und blinkende Einzelteile würden den Flug ruckeln lassen.
    // Nebel: Bach und Fluss mehrfach breit nachgezeichnet – weiche Ränder ohne Weichzeichner
    const nebel = neu('g', { class: 'tz-nebel' });
    const wasser = [...karte.querySelectorAll('.k-bach, .k-fluss, .k-wasser')].map((w) => w.getAttribute('d')).filter(Boolean).join('');
    for (const breite of [100, 80, 62, 46, 32]) nebel.append(neu('path', { d: wasser, class: 'tz-nebel__band', 'stroke-width': String(breite) }));
    // Fensterlicht: jedes sechste Haus (fest, damit es bei jedem Besuch gleich aussieht)
    const haeuser = karte.querySelector('.k-haus')?.getAttribute('d')?.split('M').filter(Boolean) ?? [];
    const fenster = neu('path', { class: 'tz-fenster', d: haeuser.filter((_, i) => (i * 7919) % 6 === 0).map((h) => 'M' + h).join('') });
    // Laternen alle ~24 Karteneinheiten entlang der Straßen, als ein einziger Pfad (Lichtkegel + Lampe)
    const punkte: string[] = [];
    karte.querySelectorAll<SVGPathElement>('.k-wohnstrasse, .k-hauptstrasse').forEach((strasse) => {
      const laenge = strasse.getTotalLength();
      for (let s = 12; s < laenge && punkte.length < 700; s += 24) {
        const p = strasse.getPointAtLength(s);
        punkte.push(`${p.x.toFixed(1)},${p.y.toFixed(1)}`);
      }
    });
    const kreise = (r: number) => punkte.map((xy) => { const [x, y] = xy.split(',').map(Number); return `M${(x - r).toFixed(1)},${y}a${r},${r} 0 1,0 ${2 * r},0a${r},${r} 0 1,0 ${-2 * r},0`; }).join('');
    const laternen = neu('g', { class: 'tz-laternen' });
    laternen.append(neu('path', { class: 'tz-laternen__schein', d: kreise(6) }), neu('path', { class: 'tz-laternen__lampe', d: kreise(1.6) }));
    // über die Häuser, unter das Ziel (leuchtendes Haus bleibt obenauf)
    const ziel = karte.querySelector('.zuhause');
    karte.insertBefore(nebel, ziel);
    karte.insertBefore(fenster, ziel);
    karte.insertBefore(laternen, ziel);
    // Sterne am Bildrand
    const sterne = ebene.querySelector<HTMLElement>('.drohne__sterne')!;
    let zufall = 7;
    const z = () => ((zufall = (zufall * 16807) % 2147483647) / 2147483647);
    sterne.style.boxShadow = Array.from({ length: 160 }, () => `${(z() * 100).toFixed(2)}vw ${(z() * 100).toFixed(2)}vh 0 ${z() < 0.15 ? 1 : 0}px rgb(255 255 255 / ${(0.4 + z() * 0.6).toFixed(2)})`).join(',');
    tageszeit();
    setInterval(tageszeit, 60000);
  }

  function tageszeit() {
    const s = sonne();
    const p = testzeit ?? phase(s);
    ebene.dataset.tageszeit = p;
    hud.sonne.textContent = String(Math.round(s.hoehe));
    if (p !== letztePhase) {
      letztePhase = p;
      dispatchEvent(new CustomEvent('protokoll', { detail: lichtTexte[p] }));
    }
  }

  async function laden() {
    if (svg || laedt) return;
    laedt = true;
    try {
      const text = await (await fetch(ebene.dataset.quelle!)).text();
      svg = new DOMParser().parseFromString(text, 'image/svg+xml').documentElement as unknown as SVGSVGElement;
      // Leuchtendes Ziel: Hausumriss mit Glow und pulsierendem Ring
      const ziel = JSON.parse(ebene.dataset.zuhause!);
      const ns = 'http://www.w3.org/2000/svg';
      const g = document.createElementNS(ns, 'g');
      g.setAttribute('class', 'zuhause');
      g.innerHTML = `
        <defs><filter id="leuchten" x="-200%" y="-200%" width="500%" height="500%">
          <feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter></defs>
        <circle class="zuhause__ring" cx="${ziel.x}" cy="${ziel.y}" r="6">
          <animate attributeName="r" values="6;34" dur="2.4s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.9;0" dur="2.4s" repeatCount="indefinite"/>
        </circle>
        <circle class="zuhause__ring" cx="${ziel.x}" cy="${ziel.y}" r="6">
          <animate attributeName="r" values="6;34" dur="2.4s" begin="1.2s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.9;0" dur="2.4s" begin="1.2s" repeatCount="indefinite"/>
        </circle>
        <path class="zuhause__haus" d="${ziel.umriss}" filter="url(#leuchten)"/>`;
      svg.append(g);
      flaeche.append(svg);
      tageszeitAufbauen(svg);
      ebene.classList.add('bereit');
      planen();
    } catch {
      laedt = false;
    }
  }

  function umschalten() {
    clearInterval(uhr);
    if (!modern()) return;
    laden();
    flugbeginn = performance.now();
    uhrStellen();
    uhr = window.setInterval(uhrStellen, 1000);
    planen();
  }

  addEventListener('scroll', planen, { passive: true });
  addEventListener('resize', planen);
  new MutationObserver(umschalten).observe(wurzel, { attributes: true, attributeFilter: ['data-stil'] });
  umschalten();
</script>
