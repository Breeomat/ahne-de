---
// Überraschungen auf der Startseite:
// - Einsatz 112: „112“ tippen oder dreimal schnell auf „aktives Mitglied, Kassenwart“ (Feuerwehr) → Blaulicht, Drohne rückt aus
// - Hobbys antippen (data-ei in src/lib/ueber-mich.ts): Drohne (Looping), Urlaub (Liegestuhl), Schalke (Tor + Looping), Wurstbude (Grill), Perry Rhodan (Hyperraum),
//   Kochen (Rezept des Tages aus src/lib/rezepte.ts, nur wenn dort Rezepte stehen)
// Jede Überraschung schreibt ins Live-Protokoll (Ereignis „protokoll“).
import type { Sprache } from '../lib/sprache';
import { rezepte } from '../lib/rezepte';

interface Props {
  sprache: Sprache;
}

const { sprache } = Astro.props;
const de = sprache === 'de';
const texte = de
  ? {
      alarm: 'Alarmierung über 112. Die Drohne rückt zum Feuerwehrhaus aus. Die Sitzung wird unterbrochen.',
      einsatzEnde: 'Einsatz beendet. Der Kassenwart ist zufrieden. Die Sitzung wird fortgesetzt.',
      meldungEnde: 'Einsatz beendet – Kassenwart zufrieden',
      meldungAlarm: 'EINSATZ · Drohne rückt aus',
      tor: 'TOOOR!',
      schalke: 'Tor für Schalke 04. Die Sitzung wird für Jubel kurz unterbrochen. Die Drohne fliegt einen Looping.',
      perry: 'Hyperraumsprung durchgeführt. Rückkehr in den Normalraum erfolgreich.',
      drohne: 'Die Drohne fliegt auf Wunsch einen Looping. Beifall aus dem Publikum.',
      urlaub: 'Die Sitzung wird kurz für Urlaub unterbrochen. Der Liegestuhl ist aufgestellt.',
      urlaubText: 'Kurz mal Urlaub …',
      wurstGewendet: 'Die Bratwurst wird gewendet.',
      wurstPerfekt: 'Bratwurst perfekt gegrillt. Beschluss: ab ins Brötchen. Abstimmung: einstimmig.',
      wurstKohle: 'Bratwurst leicht angekohlt – wie beim Dorffest. Sie wird trotzdem verzehrt.',
      wurstRoh: 'Noch roh – zurück auf den Grill!',
      stufen: ['roh', 'angebraten', 'perfekt', 'angekohlt'],
      oben: 'Oben',
      unten: 'Unten',
      kochen: 'Das Rezept des Tages wird vorgelegt: {titel}.',
    }
  : {
      alarm: 'Emergency call 112. The drone responds to the fire station. The meeting is suspended.',
      einsatzEnde: 'Callout finished. The treasurer is satisfied. The meeting resumes.',
      meldungEnde: 'Callout finished – treasurer satisfied',
      meldungAlarm: 'CALLOUT · drone responding',
      tor: 'GOAAAL!',
      schalke: 'Goal for Schalke 04. The meeting is briefly interrupted for celebrations. The drone flies a loop.',
      perry: 'Hyperspace jump completed. Return to normal space successful.',
      drohne: 'The drone flies a loop on request. Applause from the audience.',
      urlaub: 'The meeting is briefly adjourned for a holiday. The deckchair is set up.',
      urlaubText: 'Quick holiday break …',
      wurstGewendet: 'The bratwurst is turned.',
      wurstPerfekt: 'Bratwurst grilled to perfection. Resolution: into the bun. Vote: unanimous.',
      wurstKohle: 'Bratwurst slightly charred – just like at the village festival. It is eaten anyway.',
      wurstRoh: 'Still raw – back on the grill!',
      stufen: ['raw', 'seared', 'perfect', 'charred'],
      oben: 'Top',
      unten: 'Bottom',
      kochen: 'The recipe of the day is presented: {titel}.',
    };
---
<div class="blaulicht" aria-hidden="true"></div>
<div class="meldung" role="status" aria-live="polite"></div>
<div class="tor" aria-hidden="true"><canvas></canvas><strong>{texte.tor}</strong></div>
<div class="urlaub" aria-hidden="true">
  <svg viewBox="0 0 400 260">
    <defs>
      <linearGradient id="himmel" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7fc8f8" /><stop offset="1" stop-color="#ffe7b0" /></linearGradient>
      <pattern id="streifen" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(28)"><rect width="6" height="12" fill="#1f5fae" /><rect x="6" width="6" height="12" fill="#ffffff" /></pattern>
      <clipPath id="bild"><rect width="400" height="260" rx="22" /></clipPath>
    </defs>
    <g clip-path="url(#bild)">
      <rect width="400" height="260" fill="url(#himmel)" />
      <g class="urlaub__sonne"><circle cx="330" cy="60" r="26" fill="#ffd34d" />{[0, 45, 90, 135, 180, 225, 270, 315].map((w) => <line x1="330" y1="22" x2="330" y2="10" transform={`rotate(${w} 330 60)`} />)}</g>
      <g class="urlaub__moewe"><path d="M60 70 q8 -8 16 0 q8 -8 16 0" /><path d="M110 50 q6 -6 12 0 q6 -6 12 0" /></g>
      <rect y="150" width="400" height="50" fill="#2f86c9" />
      <path class="urlaub__welle" d="M-40 150 q20 -8 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 v12 h-480 z" fill="#5fb2e8" />
      <rect y="195" width="400" height="65" fill="#f1d9a6" />
      <g class="urlaub__schirm"><line x1="318" y1="240" x2="318" y2="112" /><path d="M248 120 Q318 60 388 120 Z" fill="#e2463b" /><path d="M283 120 Q318 66 318 66 Q318 66 353 120 Z" fill="#ffffff" /></g>
      <g class="urlaub__stuhl">
        <path d="M196 112 L214 106 Q226 176 276 170 L272 182 Q206 196 196 112 Z" fill="url(#streifen)" stroke="#7a4b23" stroke-width="2" />
        <line x1="150" y1="240" x2="205" y2="110" />
        <line x1="285" y1="240" x2="248" y2="178" />
        <line x1="178" y1="240" x2="276" y2="172" />
        <line x1="205" y1="110" x2="214" y2="106" />
      </g>
    </g>
  </svg>
  <strong>{texte.urlaubText}</strong>
</div>

<dialog class="grill" aria-labelledby="grill-titel">
  <h2 id="grill-titel">{de ? 'Bratwurst vom Dorffest' : 'Village festival bratwurst'}</h2>
  <p class="grill__hinweis">{de ? 'Wenden nicht vergessen – und rechtzeitig runter vom Grill!' : 'Don’t forget to turn it – and take it off in time!'}</p>
  <svg class="grill__bild" viewBox="0 0 300 150" role="img" aria-label={de ? 'Bratwurst auf dem Grill' : 'Bratwurst on the grill'}>
    <defs>
      <radialGradient id="glut" cx="50%" cy="100%" r="80%"><stop offset="0" stop-color="#ffb347" /><stop offset="0.5" stop-color="#e2531c" /><stop offset="1" stop-color="#2a0d05" /></radialGradient>
    </defs>
    <rect class="grill__glut" x="20" y="100" width="260" height="40" rx="10" fill="url(#glut)" />
    <g class="grill__rost">{[40, 70, 100, 130, 160, 190, 220, 250].map((x) => <line x1={x} y1="62" x2={x} y2="104" />)}<line x1="25" y1="100" x2="275" y2="100" /></g>
    <g class="grill__rauch">{[110, 150, 190].map((x, i) => <circle cx={x} cy="60" r="10" style={`animation-delay:${i * 0.4}s`} />)}</g>
    <g class="grill__wurst"><rect x="55" y="62" width="190" height="34" rx="17" /><path d="M95 66 L105 92 M135 66 L145 92 M175 66 L185 92 M215 66 L225 92" /></g>
  </svg>
  <p class="grill__stand"><span>{texte.oben}: <b data-seite="oben"></b></span><span>{texte.unten}: <b data-seite="unten"></b></span></p>
  <p class="grill__ergebnis" aria-live="polite"></p>
  <div class="grill__knoepfe">
    <button type="button" data-grill="wenden">{de ? 'Wenden' : 'Turn'}</button>
    <button type="button" data-grill="runter">{de ? 'Vom Grill nehmen' : 'Take off the grill'}</button>
    <button type="button" data-grill="zu">{de ? 'Schließen' : 'Close'}</button>
  </div>
</dialog>

{rezepte.length > 0 && (
  <dialog class="rezept" aria-labelledby="rezept-titel">
    <p class="rezept__kicker">{de ? 'Rezept des Tages' : 'Recipe of the day'} · <span data-rezept-nr></span>/{rezepte.length}</p>
    {rezepte.map((r, i) => (
      <article data-rezept={i} hidden>
        <h2 id={i === 0 ? 'rezept-titel' : undefined}>{r.titel[sprache]}</h2>
        <h3>{de ? 'Zutaten' : 'Ingredients'}</h3>
        <p>{r.zutaten[sprache]}</p>
        <h3>{de ? 'Zubereitung' : 'Method'}</h3>
        <ol>{r.schritte[sprache].map((schritt) => <li>{schritt}</li>)}</ol>
      </article>
    ))}
    <div class="grill__knoepfe">
      <button type="button" data-rezept-weiter>{de ? 'Noch ein Rezept' : 'Another recipe'}</button>
      <button type="button" data-rezept-zu>{de ? 'Schließen' : 'Close'}</button>
    </div>
  </dialog>
)}

<span hidden data-ueberraschung={JSON.stringify(texte)}></span>

<script>
  import { hyperraum } from '../scripts/hyperraum';

  const t = JSON.parse(document.querySelector<HTMLElement>('[data-ueberraschung]')!.dataset.ueberraschung!);
  const wurzel = document.documentElement;
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const protokoll = (text: string) => dispatchEvent(new CustomEvent('protokoll', { detail: text }));

  // kleine Töne ohne Audiodateien (nur nach Klick/Taste, sonst blockiert der Browser ohnehin)
  let ton: AudioContext | null = null;
  function spielen(noten: [number, number, number][]) {
    try {
      ton ??= new AudioContext();
      const jetzt = ton.currentTime;
      for (const [frequenz, start, dauer] of noten) {
        const o = ton.createOscillator(), g = ton.createGain();
        o.type = 'triangle';
        o.frequency.value = frequenz;
        g.gain.setValueAtTime(0.0001, jetzt + start);
        g.gain.exponentialRampToValueAtTime(0.07, jetzt + start + 0.02);
        g.gain.exponentialRampToValueAtTime(0.0001, jetzt + start + dauer);
        o.connect(g).connect(ton.destination);
        o.start(jetzt + start);
        o.stop(jetzt + start + dauer + 0.05);
      }
    } catch {}
  }

  const meldung = document.querySelector<HTMLElement>('.meldung')!;
  let meldungZeit: number | undefined;
  function melden(text: string, ms = 4000) {
    meldung.textContent = text;
    meldung.classList.add('sichtbar');
    clearTimeout(meldungZeit);
    meldungZeit = window.setTimeout(() => meldung.classList.remove('sichtbar'), ms);
  }

  // ---------- Einsatz 112 ----------
  let imEinsatz = false;
  function einsatz() {
    if (imEinsatz) return;
    imEinsatz = true;
    wurzel.classList.add('im-einsatz');
    melden(t.meldungAlarm, 6500);
    protokoll(t.alarm);
    // Martinshorn: tatü-tata
    spielen(Array.from({ length: 8 }, (_, i) => [i % 2 ? 440 : 585, i * 0.45, 0.42] as [number, number, number]));
    dispatchEvent(new CustomEvent('drohne:einsatz'));
    window.setTimeout(() => wurzel.classList.remove('im-einsatz'), 7000);
  }
  addEventListener('drohne:einsatz-ende', () => {
    imEinsatz = false;
    melden(t.meldungEnde);
    protokoll(t.einsatzEnde);
  });
  let tasten = '';
  addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).closest('input, textarea')) return;
    tasten = (tasten + e.key).slice(-3);
    if (tasten === '112') einsatz();
  });
  let klicks: number[] = [];
  document.querySelector('[data-ei="feuerwehr"]')?.addEventListener('click', () => {
    const jetzt = performance.now();
    klicks = [...klicks.filter((k) => jetzt - k < 1500), jetzt];
    if (klicks.length >= 3) { klicks = []; einsatz(); }
  });

  // ---------- Schalke: Tor, Konfetti, Looping ----------
  const tor = document.querySelector<HTMLElement>('.tor')!;
  const leinwand = tor.querySelector('canvas')!;
  function schalke() {
    protokoll(t.schalke);
    dispatchEvent(new CustomEvent('drohne:looping'));
    spielen([[523, 0, 0.18], [659, 0.18, 0.18], [784, 0.36, 0.18], [1047, 0.54, 0.6], [784, 0.9, 0.15], [1047, 1.05, 0.7]]);
    tor.classList.remove('los');
    void tor.offsetWidth;
    tor.classList.add('los');
    if (ruhig) return;
    const dpr = Math.min(2, devicePixelRatio || 1);
    leinwand.width = innerWidth * dpr;
    leinwand.height = innerHeight * dpr;
    const g = leinwand.getContext('2d')!;
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    const farben = ['#004d9d', '#ffffff', '#1a73e8', '#003a75'];
    const teile = Array.from({ length: 180 }, () => ({
      x: innerWidth / 2 + (Math.random() - 0.5) * 120, y: innerHeight * 0.55,
      vx: (Math.random() - 0.5) * 16, vy: -Math.random() * 18 - 6,
      d: Math.random() * Math.PI, vd: (Math.random() - 0.5) * 0.4,
      f: farben[Math.floor(Math.random() * farben.length)], b: Math.random() * 8 + 5,
    }));
    const start = performance.now();
    (function bild(jetzt: number) {
      const s = (jetzt - start) / 1000;
      g.clearRect(0, 0, innerWidth, innerHeight);
      for (const k of teile) {
        k.vy += 0.45; k.vx *= 0.99; k.x += k.vx; k.y += k.vy; k.d += k.vd;
        g.save(); g.translate(k.x, k.y); g.rotate(k.d); g.fillStyle = k.f;
        g.globalAlpha = Math.max(0, 1 - s / 3); g.fillRect(-k.b / 2, -k.b / 4, k.b, k.b / 2); g.restore();
      }
      if (s < 3) requestAnimationFrame(bild);
      else g.clearRect(0, 0, innerWidth, innerHeight);
    })(start);
  }

  // ---------- Wurstbude: Grill ----------
  const grill = document.querySelector<HTMLDialogElement>('.grill')!;
  const wurst = grill.querySelector<SVGGElement>('.grill__wurst')!;
  const ergebnis = grill.querySelector<HTMLElement>('.grill__ergebnis')!;
  const anzeigeOben = grill.querySelector<HTMLElement>('[data-seite="oben"]')!;
  const anzeigeUnten = grill.querySelector<HTMLElement>('[data-seite="unten"]')!;
  let seiten = [0, 0];
  let unten = 0;
  let grillUhr: number | undefined;
  const stufe = (g: number) => t.stufen[g < 0.35 ? 0 : g < 0.7 ? 1 : g <= 1.1 ? 2 : 3];
  // Farbe von rosa (roh) über braun (perfekt) bis schwarz (angekohlt)
  const farbe = (g: number) => {
    const punkte = [[0, [232, 160, 150]], [0.7, [176, 98, 56]], [1.1, [120, 62, 30]], [1.5, [38, 24, 18]]] as const;
    let i = 0;
    while (i < punkte.length - 2 && g > punkte[i + 1][0]) i++;
    const [a, ca] = punkte[i], [b, cb] = punkte[i + 1];
    const k = Math.min(1, Math.max(0, (g - a) / (b - a)));
    return `rgb(${ca.map((c, j) => Math.round(c + (cb[j] - c) * k)).join(',')})`;
  };
  function grillZeigen() {
    const oben = seiten[1 - unten];
    wurst.style.setProperty('--wurst', farbe(oben));
    anzeigeOben.textContent = stufe(oben);
    anzeigeUnten.textContent = stufe(seiten[unten]);
    grill.classList.toggle('qualm', seiten[unten] > 1);
  }
  function wurstbude() {
    seiten = [0, 0];
    unten = 0;
    ergebnis.textContent = '';
    grillZeigen();
    grill.showModal();
    clearInterval(grillUhr);
    grillUhr = window.setInterval(() => {
      seiten[unten] = Math.min(1.6, seiten[unten] + 0.012);
      grillZeigen();
    }, 100);
  }
  grill.addEventListener('close', () => clearInterval(grillUhr));
  grill.addEventListener('click', (e) => {
    const knopf = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-grill]');
    if (!knopf) return;
    const aktion = knopf.dataset.grill;
    if (aktion === 'wenden') {
      unten = 1 - unten;
      wurst.classList.remove('dreht');
      void wurst.getBoundingClientRect();
      wurst.classList.add('dreht');
      grillZeigen();
      protokoll(t.wurstGewendet);
    } else if (aktion === 'runter') {
      if (seiten.some((g) => g > 1.1)) { ergebnis.textContent = t.wurstKohle; protokoll(t.wurstKohle); clearInterval(grillUhr); }
      else if (seiten.every((g) => g >= 0.7)) { ergebnis.textContent = t.wurstPerfekt; protokoll(t.wurstPerfekt); clearInterval(grillUhr); spielen([[784, 0, 0.15], [1047, 0.15, 0.4]]); }
      else ergebnis.textContent = t.wurstRoh;
    } else grill.close();
  });

  // ---------- Perry Rhodan ----------
  async function perry() {
    spielen([[220, 0, 1.2], [330, 0.1, 1.1], [880, 0.6, 0.5]]);
    await hyperraum('durch', 900);
    protokoll(t.perry);
  }

  // ---------- Kochen: Rezept des Tages ----------
  const rezept = document.querySelector<HTMLDialogElement>('.rezept');
  const rezeptListe = rezept ? [...rezept.querySelectorAll<HTMLElement>('[data-rezept]')] : [];
  // jeden Tag ein anderes Rezept (Tag seit 1970, Ortszeit)
  let rezeptNr = Math.floor((Date.now() - new Date().getTimezoneOffset() * 60000) / 86400000) % Math.max(1, rezeptListe.length);
  function rezeptZeigen() {
    rezeptListe.forEach((r, i) => (r.hidden = i !== rezeptNr));
    rezept!.querySelector('[data-rezept-nr]')!.textContent = String(rezeptNr + 1);
    rezept!.scrollTop = 0;
    protokoll(t.kochen.replace('{titel}', rezeptListe[rezeptNr].querySelector('h2')!.textContent!));
  }
  rezept?.querySelector('[data-rezept-zu]')?.addEventListener('click', () => rezept.close());
  rezept?.querySelector('[data-rezept-weiter]')?.addEventListener('click', () => {
    rezeptNr = (rezeptNr + 1) % rezeptListe.length;
    rezeptZeigen();
  });
  function kochen() {
    if (!rezept) return;
    rezeptZeigen();
    rezept.showModal();
    // showModal setzt den Fokus auf den ersten Knopf unten – Rezept trotzdem von oben zeigen
    rezept.scrollTop = 0;
  }

  // ---------- Drohne fliegen: Looping ----------
  function drohne() {
    dispatchEvent(new CustomEvent('drohne:looping'));
    spielen([[300, 0, 0.5], [450, 0.25, 0.5], [700, 0.6, 0.4]]);
    protokoll(t.drohne);
  }

  // ---------- Urlaub: Liegestuhl ----------
  const urlaub = document.querySelector<HTMLElement>('.urlaub')!;
  let urlaubZeit: number | undefined;
  function urlaubMachen() {
    urlaub.classList.remove('los');
    void urlaub.offsetWidth;
    urlaub.classList.add('los');
    clearTimeout(urlaubZeit);
    urlaubZeit = window.setTimeout(() => urlaub.classList.remove('los'), 3800);
    // leises Meeresrauschen
    try {
      ton ??= new AudioContext();
      const dauer = 3, puffer = ton.createBuffer(1, ton.sampleRate * dauer, ton.sampleRate), d = puffer.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * Math.sin((Math.PI * i) / d.length) * 0.5;
      const q = ton.createBufferSource(), f = ton.createBiquadFilter(), g = ton.createGain();
      q.buffer = puffer; f.type = 'lowpass'; f.frequency.value = 700; g.gain.value = 0.08;
      q.connect(f).connect(g).connect(ton.destination); q.start();
    } catch {}
    protokoll(t.urlaub);
  }

  const aktionen: Record<string, () => void> = { schalke, wurst: wurstbude, perry, kochen, drohne, urlaub: urlaubMachen };
  document.querySelectorAll<HTMLButtonElement>('button[data-ei]').forEach((b) => b.addEventListener('click', () => aktionen[b.dataset.ei!]?.()));
</script>
