---
import Basis from '../layouts/Basis.astro';
import Drohnenflug from './Drohnenflug.astro';
import Ueberraschungen from './Ueberraschungen.astro';
import { rezepte } from '../lib/rezepte';
import logbuch from '../data/logbuch.json';
import { person, url } from '../lib/site';
import { seiten, ui, type Sprache } from '../lib/sprache';
import { einleitung, ehrenamt, gernMache } from '../lib/ueber-mich';

interface Props {
  sprache: Sprache;
}

const { sprache } = Astro.props;
const t = ui[sprache];
// Drohnen-Logbuch: nachts von scripts/logbuch.mjs geschrieben (Claude, Wetter von Open-Meteo, Termine von stockhausen-online)
const eintrag = logbuch as { datum: string | null; de?: string; en?: string };
const logbuchDatum = eintrag.datum
  ? new Date(`${eintrag.datum}T12:00:00`).toLocaleDateString(sprache === 'de' ? 'de-DE' : 'en-GB', { weekday: 'long', day: 'numeric', month: 'long' })
  : '';
---
<Basis sprache={sprache} seite="start">
  <Drohnenflug sprache={sprache} />
  <Ueberraschungen sprache={sprache} />
  <h1><span class="vorname" data-visitenkarte={url(seiten.visitenkarte[sprache])}>{person.name.split(' ')[0]}</span> {person.name.split(' ').slice(1).join(' ')}</h1>
  <p class="untertitel">{t.untertitel}</p>

  <p class="einleitung block">{einleitung[sprache]}</p>

  {eintrag.datum && eintrag[sprache] && (
    <section class="block logbuch">
      <h2>{sprache === 'de' ? 'Was steht heute an?' : 'What’s on today?'}</h2>
      <p class="logbuch__datum">{logbuchDatum}</p>
      <p>{eintrag[sprache]}</p>
      <p class="logbuch__hinweis">
        {sprache === 'de'
          ? 'Jede Nacht automatisch von einer KI (Claude) geschrieben – aus Wetterdaten von '
          : 'Written automatically every night by an AI (Claude) – from weather data by '}
        <a href="https://open-meteo.com/">Open-Meteo.com</a>
        {sprache === 'de' ? ' und den Terminen von ' : ' and the events on '}
        <a href="https://stockhausen-online.de/termine/">stockhausen-online.de</a>.
      </p>
    </section>
  )}

  <section class="block">
  <h2>{t.ehrenamt}</h2>
  <ul class="liste">
    {ehrenamt.map(({ name, rolle, href }) => (
      <li>
        {href ? <a href={href}>{name[sprache]}</a> : <strong>{name[sprache]}</strong>}
        <span data-ei={href?.includes('feuerwehr') ? 'feuerwehr' : undefined}>{rolle[sprache]}</span>
      </li>
    ))}
  </ul>
  </section>

  <section class="block">
  <h2>{t.gernMache}</h2>
  <ul class="punkte">
    {gernMache.map((eintrag) => {
      // Überraschung nur, wenn es etwas zu zeigen gibt (Kochen braucht Rezepte)
      const ei = eintrag.ei === 'kochen' && rezepte.length === 0 ? undefined : eintrag.ei;
      return ei ? <li><button type="button" class="ei" data-ei={ei}>{eintrag[sprache]}<span aria-hidden="true">✦</span></button></li> : <li>{eintrag[sprache]}</li>;
    })}
  </ul>
  </section>

  <section class="block">
  <h2>{t.kontakt}</h2>
  <p><a href={`mailto:${person.email}`}>{person.email}</a></p>
  </section>

  <p class="drohne-quelle">
    {sprache === 'de' ? 'Drohnenflug über Stockhausen – Kartendaten' : 'Drone flight over Stockhausen – map data'}
    © <a href="https://www.openstreetmap.org/copyright">{sprache === 'de' ? 'OpenStreetMap-Mitwirkende' : 'OpenStreetMap contributors'}</a>
    · {sprache === 'de' ? 'Korsika' : 'Corsica'}: <a href="https://www.naturalearthdata.com/">Natural Earth</a>
  </p>
</Basis>
