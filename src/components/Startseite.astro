---
import Basis from '../layouts/Basis.astro';
import Drohnenflug from './Drohnenflug.astro';
import Protokoll from './Protokoll.astro';
import Ueberraschungen from './Ueberraschungen.astro';
import { rezepte } from '../lib/rezepte';
import { person } from '../lib/site';
import { ui, type Sprache } from '../lib/sprache';
import { einleitung, ehrenamt, gernMache } from '../lib/ueber-mich';

interface Props {
  sprache: Sprache;
}

const { sprache } = Astro.props;
const t = ui[sprache];
---
<Basis sprache={sprache} seite="start">
  <Drohnenflug sprache={sprache} />
  <Protokoll sprache={sprache} />
  <Ueberraschungen sprache={sprache} />
  <h1>{person.name}</h1>
  <p class="untertitel">{t.untertitel}</p>

  <p class="einleitung block">{einleitung[sprache]}</p>

  <section class="block" data-top="ehrenamt">
  <h2>{t.ehrenamt}</h2>
  <ul class="liste">
    {ehrenamt.map(({ name, rolle, href }) => (
      <li>
        {href ? <a href={href}>{name[sprache]}</a> : <strong>{name[sprache]}</strong>}
        <span data-ei={href?.includes('feuerwehr') ? 'feuerwehr' : undefined}>{rolle[sprache]}</span>
      </li>
    ))}
  </ul>
  </section>

  <section class="block" data-top="hobbys">
  <h2>{t.gernMache}</h2>
  <ul class="punkte">
    {gernMache.map((eintrag) => {
      // Überraschung nur, wenn es etwas zu zeigen gibt (Kochen braucht Rezepte)
      const ei = eintrag.ei === 'kochen' && rezepte.length === 0 ? undefined : eintrag.ei;
      return ei ? <li><button type="button" class="ei" data-ei={ei}>{eintrag[sprache]}<span aria-hidden="true">✦</span></button></li> : <li>{eintrag[sprache]}</li>;
    })}
  </ul>
  </section>

  <section class="block" data-top="kontakt">
  <h2>{t.kontakt}</h2>
  <p><a href={`mailto:${person.email}`}>{person.email}</a></p>
  </section>

  <p class="drohne-quelle">
    {sprache === 'de' ? 'Drohnenflug über Stockhausen – Kartendaten' : 'Drone flight over Stockhausen – map data'}
    © <a href="https://www.openstreetmap.org/copyright">{sprache === 'de' ? 'OpenStreetMap-Mitwirkende' : 'OpenStreetMap contributors'}</a>
    · {sprache === 'de' ? 'Korsika' : 'Corsica'}: <a href="https://www.naturalearthdata.com/">Natural Earth</a>
  </p>
</Basis>
