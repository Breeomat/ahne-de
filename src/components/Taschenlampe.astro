---
// Nachtmodus mit Taschenlampe (Startseite): Nachts (Tageszeit des Drohnenflugs, data-tageszeit="nacht" an .drohne)
// ist die Seite dunkel, Maus oder Finger leuchten wie eine Taschenlampe, Brummi hat einen eigenen kleinen Lichtkegel.
// „Licht an“ schaltet die Dunkelheit für diesen Seitenbesuch ab. Tastatur: Der Lichtkegel springt zum fokussierten Element.
// Testen mit ?zeit=nacht. Entfernen: diese Datei und die Einbindung in Startseite.astro löschen.
import type { Sprache } from '../lib/sprache';

interface Props {
  sprache: Sprache;
}
const { sprache } = Astro.props;
const de = sprache === 'de';
---
<div class="lampe" aria-hidden="true" hidden>
  <p class="lampe__hinweis">{de ? 'Nachts ist es dunkel in Stockhausen. Leuchte mit Maus oder Finger.' : 'It’s dark in Stockhausen at night. Use your mouse or finger as a torch.'}</p>
</div>
<button type="button" class="lampe__schalter" hidden data-an={de ? 'Licht an' : 'Lights on'} data-aus={de ? 'Taschenlampe' : 'Torch'}>{de ? 'Licht an' : 'Lights on'}</button>

<script>
  const lampe = document.querySelector<HTMLElement>('.lampe')!;
  const schalter = document.querySelector<HTMLButtonElement>('.lampe__schalter')!;
  const ebene = document.querySelector<HTMLElement>('.drohne');
  const brummi = document.querySelector<HTMLElement>('.brummi');
  let lichtAn = false; // „Licht an“ gedrückt (nur für diesen Besuch)
  let licht = { x: innerWidth / 2, y: innerHeight * 0.35 };
  let aktiv = false;

  function pruefen() {
    const nacht = ebene?.dataset.tageszeit === 'nacht';
    aktiv = nacht && !lichtAn;
    lampe.hidden = !aktiv;
    schalter.hidden = !nacht;
    schalter.textContent = lichtAn ? schalter.dataset.aus! : schalter.dataset.an!;
    if (aktiv) {
      lampe.classList.remove('aus');
      setTimeout(() => lampe.classList.add('ohne-hinweis'), 6000);
    }
  }
  if (ebene) new MutationObserver(pruefen).observe(ebene, { attributes: true, attributeFilter: ['data-tageszeit'] });
  pruefen();

  schalter.addEventListener('click', () => {
    lichtAn = !lichtAn;
    pruefen();
  });

  const setzen = (x: number, y: number) => (licht = { x, y });
  addEventListener('pointermove', (e) => setzen(e.clientX, e.clientY), { passive: true });
  addEventListener('pointerdown', (e) => setzen(e.clientX, e.clientY), { passive: true });
  // Tastatur: Licht auf das fokussierte Element
  addEventListener('focusin', (e) => {
    const r = (e.target as HTMLElement).getBoundingClientRect?.();
    if (r && r.width) setzen(r.left + r.width / 2, r.top + r.height / 2);
  });

  function schritt() {
    if (aktiv) {
      lampe.style.setProperty('--lx', `${licht.x.toFixed(0)}px`);
      lampe.style.setProperty('--ly', `${licht.y.toFixed(0)}px`);
      if (brummi) {
        const r = brummi.getBoundingClientRect();
        lampe.style.setProperty('--bx', `${(r.left + r.width / 2).toFixed(0)}px`);
        lampe.style.setProperty('--by', `${(r.top + r.height / 2).toFixed(0)}px`);
      }
    }
    requestAnimationFrame(schritt);
  }
  requestAnimationFrame(schritt);
</script>

<style>
  .lampe {
    position: fixed; inset: 0; z-index: 30; pointer-events: none;
    --lx: 50vw; --ly: 35vh; --bx: -200px; --by: -200px;
    background: rgb(2 4 10 / 0.94);
    -webkit-mask-image: radial-gradient(circle 150px at var(--lx) var(--ly), transparent 0 55%, #000 100%),
      radial-gradient(circle 70px at var(--bx) var(--by), transparent 0 45%, #000 100%);
    -webkit-mask-composite: source-in;
    mask-image: radial-gradient(circle 150px at var(--lx) var(--ly), transparent 0 55%, #000 100%),
      radial-gradient(circle 70px at var(--bx) var(--by), transparent 0 45%, #000 100%);
    mask-composite: intersect;
  }
  .lampe[hidden] { display: none; }
  .lampe__hinweis {
    position: absolute; left: 50%; bottom: 22%; translate: -50% 0; width: min(90vw, 26rem); margin: 0; text-align: center;
    font: 600 0.95rem/1.4 var(--sans); color: #ffe2a0; transition: opacity 1.5s;
  }
  .lampe.ohne-hinweis .lampe__hinweis { opacity: 0; }
  .lampe__schalter {
    position: fixed; left: 16px; top: 16px; z-index: 50; padding: 0.35rem 0.8rem; border-radius: 999px;
    border: 1px solid rgb(255 226 160 / 0.6); background: rgb(10 12 20 / 0.85); color: #ffe2a0;
    font: 600 0.78rem var(--sans); cursor: pointer;
  }
  .lampe__schalter[hidden] { display: none; }
</style>
