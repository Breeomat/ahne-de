    function wpPunkt(name) {
      if (!WPDATEN.pumpen || !WPDATEN.pumpen[name]) return null;
      const sek = Math.floor(stunde() * 3600), t = WPDATEN.ende - 86400 + sek;
      const v = WPDATEN.pumpen[name].verlauf;
      let lo = 0, hi = v.length - 1, best = -1;
      while (lo <= hi) { const m = (lo + hi) >> 1; if (v[m].t <= t) { best = m; lo = m + 1; } else hi = m - 1; }
      return best >= 0 && t - v[best].t <= 1800 ? v[best] : null;
    }
