    function sonnenhoehe() {
      const d = new Date(), j = (Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - Date.UTC(d.getFullYear(), 0, 0)) / 864e5;
      const dekl = 23.44 * Math.sin((2 * Math.PI * (284 + j)) / 365) * Math.PI / 180, br = 50.56 * Math.PI / 180;
      const mittag = 12 - 9.44 / 15 - d.getTimezoneOffset() / 60, ha = (stunde() - mittag) * 15 * Math.PI / 180;
      return Math.asin(Math.sin(br) * Math.sin(dekl) + Math.cos(br) * Math.cos(dekl) * Math.cos(ha));
