---
// „Haus-Männchen“ – öffentliches Zuschauerspiel im Pixel-Stil (/haus/, /en/house/). Eigener Entwurf.
// Ein dreistöckiges Haus im Querschnitt, ein Männchen mit Bedürfnissen (Hunger, Energie, Spaß, Hygiene),
// das seinen Tag selbst lebt: kocht, isst, liest, sieht fern, bastelt, duscht, schläft – mit Sprechblasen.
// Mitmachen: Gegenstände anklicken, Essen hinstellen, Licht, Anklopfen, Brief schreiben (Antwort aus festen Sätzen,
// nichts wird gesendet oder gespeichert).
// Stockhausen: Uhrzeit und Sonnenstand des Besuchers, echtes Wetter (src/data/wetter.json wie beim Drohnenflug),
// Blick aus den Fenstern aufs Dorf, Dorfzeitung mit den Terminen von stockhausen-online (src/data/termine.json,
// scripts/termine.mjs im Workflow). Test: ?wetter=klar|wolkig|bedeckt|nebel|niesel|regen|schnee|gewitter,
// ?zeit=nacht|morgen|tag|abend.
// Grafik: Puffer 320×240 in ganzen Pixeln, ohne Glättung 3× vergrößert; Schrift (Raumnamen, Sprechblasen) wird
// scharf auf der großen Leinwand gezeichnet.
import Basis from '../layouts/Basis.astro';
import type { Sprache } from '../lib/sprache';
import wetter from '../data/wetter.json';
import termineDaten from '../data/termine.json';

interface Props {
  sprache: Sprache;
}
const { sprache } = Astro.props;
const de = sprache === 'de';
const termine = (termineDaten as { termine?: { tag: string; titel: string; ort?: string }[] }).termine ?? [];
const texte = de
  ? {
      titel: 'Haus-Männchen',
      beschreibung: 'Ein kleines Männchen in seinem Haus in Stockhausen. Zusehen, Gegenstände anklicken oder mitmachen.',
      hinweis: 'Klick auf einen Gegenstand, dann geht das Männchen dorthin. Wetter und Uhrzeit sind echt.',
      essen: 'Essen hinstellen', licht: 'Licht an/aus', klopfen: 'Anklopfen', brief: 'Brief schreiben', zeitung: 'Dorfzeitung',
      briefPlatz: 'Was möchtest du dem Männchen schreiben?', senden: 'Einwerfen',
      briefHinweis: 'Der Brief bleibt in deinem Browser, nichts wird gesendet oder gespeichert.',
      zeitungTitel: 'Dorfzeitung Stockhausen', keineTermine: 'In den nächsten zwei Wochen stehen keine Termine im Kalender.',
      alleTermine: 'Alle Termine auf stockhausen-online.de',
      hunger: 'Hunger', energie: 'Energie', spass: 'Spaß', hygiene: 'Hygiene',
    }
  : {
      titel: 'House figure',
      beschreibung: 'A little figure living in its house in Stockhausen. Watch, click on objects or join in.',
      hinweis: 'Click an object and the figure will go there. Weather and time of day are real.',
      essen: 'Serve a meal', licht: 'Lights on/off', klopfen: 'Knock', brief: 'Write a letter', zeitung: 'Village paper',
      briefPlatz: 'What would you like to write to the figure?', senden: 'Post it',
      briefHinweis: 'The letter stays in your browser; nothing is sent or stored.',
      zeitungTitel: 'Stockhausen village paper', keineTermine: 'No events in the calendar for the next two weeks.',
      alleTermine: 'All events on stockhausen-online.de (German)',
      hunger: 'Hunger', energie: 'Energy', spass: 'Fun', hygiene: 'Hygiene',
    };
---
<Basis sprache={sprache} seite="haus" titel={texte.titel} beschreibung={texte.beschreibung}>
  <section class="haus">
    <h1>{texte.titel}</h1>
    <p class="haus__intro">{texte.beschreibung}</p>
    <div class="haus__hud">
      <span id="haus-uhr"></span>
      <span id="haus-wetter"></span>
      <span>{texte.hunger} <i class="haus__bar"><b id="haus-b-hunger"></b></i></span>
      <span>{texte.energie} <i class="haus__bar"><b id="haus-b-energy"></b></i></span>
      <span>{texte.spass} <i class="haus__bar"><b id="haus-b-fun"></b></i></span>
      <span>{texte.hygiene} <i class="haus__bar"><b id="haus-b-hygiene"></b></i></span>
    </div>
    <canvas id="haus-canvas" width="960" height="720" aria-label={texte.beschreibung} role="img"></canvas>
    <div class="haus__aktionen">
      <button type="button" data-aktion="essen">{texte.essen}</button>
      <button type="button" data-aktion="licht">{texte.licht}</button>
      <button type="button" data-aktion="klopfen">{texte.klopfen}</button>
      <button type="button" data-aktion="brief">{texte.brief}</button>
      <button type="button" data-aktion="zeitung">{texte.zeitung}</button>
    </div>
    <form class="haus__brief" id="haus-brief" hidden>
      <label for="haus-brief-text">{texte.briefPlatz}</label>
      <div>
        <input id="haus-brief-text" maxlength="120" autocomplete="off" />
        <button type="submit">{texte.senden}</button>
      </div>
      <small>{texte.briefHinweis}</small>
    </form>
    <section class="haus__zeitung" id="haus-zeitung" hidden>
      <h2>{texte.zeitungTitel}</h2>
      {termine.length === 0 && <p>{texte.keineTermine}</p>}
      {termine.length > 0 && (
        <ul>
          {termine.map((t) => (
            <li>
              <b>{new Date(t.tag + 'T12:00:00').toLocaleDateString(de ? 'de-DE' : 'en-GB', { weekday: 'short', day: '2-digit', month: '2-digit' })}</b>
              {' '}{t.titel}{t.ort ? ` – ${t.ort}` : ''}
            </li>
          ))}
        </ul>
      )}
      <p><a href="https://stockhausen-online.de/termine/">{texte.alleTermine}</a></p>
    </section>
    <p class="haus__hinweis"><small>{texte.hinweis}</small></p>
    <div id="haus-tagebuch" class="haus__tagebuch" aria-live="polite"></div>
  </section>
  <script define:vars={{ sprache, wetter, termine }}>
    const DE = sprache === 'de';
    const tr = (d, e) => (DE ? d : e);
    const cv = document.getElementById('haus-canvas');
    const g = cv.getContext('2d');
    const W = 320, H = 240, S = 3;
    const buf = document.createElement('canvas');
    buf.width = W; buf.height = H;
    const b = buf.getContext('2d');
    const reduziert = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const params = new URLSearchParams(location.search);

    // ---------------------------------------------------------------- Farben (16er-Retro-Palette, leicht abgedunkelt)
    const C = {
      schwarz: '#101014', weiss: '#F0F0E8', rot: '#A8402E', dunkelrot: '#6E2A1E', ziegel: '#8E4A30', fuge: '#6A3422',
      gruen: '#4E9A44', dunkelgruen: '#2E5E2A', blau: '#3A4AB8', hellblau: '#7AB4E8', cyan: '#7ACCD0', gelb: '#E8D850',
      orange: '#D8843A', braun: '#6B4226', dunkelbraun: '#4A2C16', grau: '#8C8C8C', hellgrau: '#C0C0C0', dunkelgrau: '#4C4C50',
      haut: '#E8B890', haar: '#5A3418', hemd: '#C84A3A', hose: '#2E3A6E', schuh: '#2A1A10', lila: '#8A4AA8',
    };

    // ---------------------------------------------------------------- Zeichen-Helfer (ganze Pixel)
    const R = (x, y, w, h, c) => { b.fillStyle = c; b.fillRect(Math.round(x), Math.round(y), Math.round(w), Math.round(h)); };
    const P = (x, y, c) => R(x, y, 1, 1, c);
    const poly = (pts, c) => { b.fillStyle = c; b.beginPath(); pts.forEach(([x, y], i) => (i ? b.lineTo(x, y) : b.moveTo(x, y))); b.closePath(); b.fill(); };

    // ---------------------------------------------------------------- Uhrzeit, Sonnenstand, Wetter
    function stunde() {
      const z = params.get('zeit');
      if (z) return { nacht: 1, morgen: 7.2, tag: 12, abend: 17.5 }[z] ?? 12;
      const d = new Date();
      return d.getHours() + d.getMinutes() / 60;
    }
    // Sonnenauf- und -untergang für Stockhausen (50,56° N, 9,44° O), einfache Näherung, Ortszeit des Besuchers
    function sonne() {
      const d = new Date(), j = (Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - Date.UTC(d.getFullYear(), 0, 0)) / 864e5;
      const dekl = 23.44 * Math.sin((2 * Math.PI * (284 + j)) / 365) * Math.PI / 180, br = 50.56 * Math.PI / 180;
      const ha = Math.acos(Math.max(-1, Math.min(1, -Math.tan(br) * Math.tan(dekl)))) * 180 / Math.PI / 15;
      const mittag = 12 - 9.44 / 15 - d.getTimezoneOffset() / 60;
      return { auf: mittag - ha, unter: mittag + ha };
    }
    const SONNE = sonne();
    function tageszeit() {
      const h = stunde();
      if (h < SONNE.auf - 0.6 || h > SONNE.unter + 0.6) return 'nacht';
      if (h < SONNE.auf + 0.6) return 'morgen';
      if (h > SONNE.unter - 0.6) return 'abend';
      return 'tag';
    }
    // Schlafenszeit nach der Uhr (nicht nach dem Sonnenuntergang)
    const schlafenszeit = () => { const h = stunde(); return h >= 22.5 || h < 6.5; };
    function wetterArt(code) {
      if (code <= 1) return 'klar';
      if (code === 2) return 'wolkig';
      if (code === 3) return 'bedeckt';
      if (code === 45 || code === 48) return 'nebel';
      if (code >= 51 && code <= 57) return 'niesel';
      if ((code >= 61 && code <= 67) || (code >= 80 && code <= 82)) return 'regen';
      if ((code >= 71 && code <= 77) || code === 85 || code === 86) return 'schnee';
      if (code >= 95) return 'gewitter';
      return 'klar';
    }
    const WETTER = (() => {
      const test = params.get('wetter');
      let art = null, temp = null, wind = 8;
      if (wetter && wetter.start) {
        const jetzt = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Berlin', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hourCycle: 'h23' }).format(new Date());
        const i = Math.round((Date.parse(jetzt.replace(' ', 'T') + ':00Z') - Date.parse(wetter.start + 'Z')) / 3600000);
        if (i >= 0 && i < wetter.code.length) { art = wetterArt(wetter.code[i]); temp = wetter.temp[i]; wind = wetter.wind[i]; }
      }
      if (test) art = test;
      return { art: art || 'klar', echt: !!art, temp, wind };
    })();
    const NASS = ['regen', 'niesel', 'gewitter'].includes(WETTER.art);
    const SCHNEE = WETTER.art === 'schnee';
    const WETTERNAME = {
      klar: tr('klar', 'clear'), wolkig: tr('wolkig', 'cloudy'), bedeckt: tr('bedeckt', 'overcast'), nebel: tr('Nebel', 'fog'),
      niesel: tr('Niesel', 'drizzle'), regen: tr('Regen', 'rain'), schnee: tr('Schnee', 'snow'), gewitter: tr('Gewitter', 'thunderstorm'),
    };

    // ---------------------------------------------------------------- Haus: Geschosse, Räume, Fenster
    const FOOT = { 1: 208, 2: 148, 3: 88 };
    const TOP = { 1: 152, 2: 92, 3: 24 };
    const ROOF = (x) => 26 + Math.abs(x - 160) * 0.492; // Innenkante der Dachschräge
    const ROOMS = [
      { id: 'dach', n: tr('Dachboden', 'Attic'), f: 3, x1: 34, x2: 286, wand: '#7A6044', boden: 'holz' },
      { id: 'schlaf', n: tr('Schlafzimmer', 'Bedroom'), f: 2, x1: 30, x2: 148, wand: '#3E3E7A', boden: 'teppich' },
      { id: 'treppe2', n: '', f: 2, x1: 148, x2: 172, wand: '#6A5440', boden: 'holz' },
      { id: 'bad', n: tr('Bad', 'Bath'), f: 2, x1: 172, x2: 222, wand: '#5E9EA8', boden: 'fliese' },
      { id: 'arbeit', n: tr('Arbeitszimmer', 'Study'), f: 2, x1: 222, x2: 290, wand: '#4E6E44', boden: 'holz' },
      { id: 'flur', n: tr('Flur', 'Hall'), f: 1, x1: 30, x2: 62, wand: '#7A6048', boden: 'fliese' },
      { id: 'kueche', n: tr('Küche', 'Kitchen'), f: 1, x1: 62, x2: 148, wand: '#A89A50', boden: 'fliese' },
      { id: 'treppe1', n: '', f: 1, x1: 148, x2: 172, wand: '#6A5440', boden: 'holz' },
      { id: 'wohn', n: tr('Wohnzimmer', 'Living room'), f: 1, x1: 172, x2: 290, wand: '#6E3E58', boden: 'holz' },
    ];
    const WAENDE = [{ f: 2, x: 148 }, { f: 2, x: 172 }, { f: 2, x: 222 }, { f: 1, x: 62 }, { f: 1, x: 148 }, { f: 1, x: 172 }];
    const FENSTER = [
      { x: 96, y: 102, w: 18, h: 20 }, { x: 246, y: 100, w: 18, h: 16 },
      { x: 86, y: 160, w: 20, h: 16 }, { x: 210, y: 158, w: 22, h: 18 },
    ];
    const RUNDFENSTER = { x: 160, y: 46, r: 7 };
    // Treppen: unten → oben (x0,y0 → x1,y1)
    const TREPPEN = { 1: { x0: 151, x1: 169, von: 1, nach: 2 }, 2: { x0: 169, x1: 151, von: 2, nach: 3 } };

    // ---------------------------------------------------------------- Gegenstände
    // act: Tätigkeit beim Benutzen, sx: Standplatz des Männchens, pose: steh|sitz|lieg
    const OBJ = [
      { id: 'stereo', n: tr('Plattenspieler', 'Record player'), f: 3, x: 74, w: 18, h: 12, act: 'musik', sx: 98 },
      { id: 'werkbank', n: tr('Werkbank', 'Workbench'), f: 3, x: 102, w: 30, h: 14, act: 'basteln', sx: 117 },
      { id: 'teleskop', n: tr('Fernrohr', 'Telescope'), f: 3, x: 178, w: 12, h: 18, act: 'sterne', sx: 190 },
      { id: 'schaukel', n: tr('Schaukelstuhl', 'Rocking chair'), f: 3, x: 202, w: 16, h: 16, act: 'ausruhen', sx: 209, pose: 'sitz' },
      { id: 'kisten', n: tr('Kisten', 'Boxes'), f: 3, x: 226, w: 16, h: 10 },
      { id: 'bett', n: tr('Bett', 'Bed'), f: 2, x: 34, w: 42, h: 14, act: 'schlafen', sx: 56, pose: 'lieg' },
      { id: 'nachttisch', n: tr('Nachttisch', 'Bedside table'), f: 2, x: 78, w: 9, h: 9 },
      { id: 'schrank', n: tr('Kleiderschrank', 'Wardrobe'), f: 2, x: 120, w: 22, h: 38 },
      { id: 'wanne', n: tr('Dusche', 'Shower'), f: 2, x: 176, w: 28, h: 14, act: 'duschen', sx: 190 },
      { id: 'waschbecken', n: tr('Waschbecken', 'Sink'), f: 2, x: 208, w: 10, h: 18, act: 'waschen', sx: 211 },
      { id: 'schreibtisch', n: tr('Computer', 'Computer'), f: 2, x: 238, w: 28, h: 14, act: 'arbeiten', sx: 234, pose: 'sitz' },
      { id: 'regal', n: tr('Bücherregal', 'Bookshelf'), f: 2, x: 270, w: 17, h: 40, act: 'lesen', sx: 262 },
      { id: 'garderobe', n: tr('Garderobe', 'Coat rack'), f: 1, x: 44, w: 8, h: 24 },
      { id: 'kuehl', n: tr('Kühlschrank', 'Fridge'), f: 1, x: 68, w: 14, h: 30, act: 'naschen', sx: 87 },
      { id: 'herd', n: tr('Herd', 'Stove'), f: 1, x: 86, w: 16, h: 16, act: 'kochen', sx: 94 },
      { id: 'spuele', n: tr('Spüle', 'Sink'), f: 1, x: 102, w: 12, h: 16 },
      { id: 'tisch', n: tr('Esstisch', 'Table'), f: 1, x: 120, w: 24, h: 11, act: 'zeitung', sx: 117, pose: 'sitz' },
      { id: 'tv', n: tr('Fernseher', 'TV'), f: 1, x: 178, w: 18, h: 17, act: 'fernsehen', sx: 222, pose: 'sitz', links: true },
      { id: 'sofa', n: tr('Sofa', 'Sofa'), f: 1, x: 206, w: 32, h: 12, act: 'ausruhen', sx: 222, pose: 'sitz', links: true },
      { id: 'lampe', n: tr('Stehlampe', 'Floor lamp'), f: 1, x: 242, w: 7, h: 30 },
      { id: 'kamin', n: tr('Kamin', 'Fireplace'), f: 1, x: 256, w: 28, h: 22, act: 'feuer', sx: 252 },
    ];
    const O = Object.fromEntries(OBJ.map((o) => [o.id, o]));
    const DAUER = { schlafen: 40, musik: 8, basteln: 9, sterne: 8, ausruhen: 8, duschen: 6, waschen: 3, arbeiten: 10, lesen: 8, naschen: 3, kochen: 7, essen: 6, zeitung: 7, fernsehen: 10, feuer: 3, tuer: 5, brief: 3 };
    const WIRKUNG = {
      schlafen: (n) => { n.energy = 100; }, musik: (n) => { n.fun = Math.min(100, n.fun + 30); },
      basteln: (n) => { n.fun = Math.min(100, n.fun + 35); }, sterne: (n) => { n.fun = Math.min(100, n.fun + 30); },
      ausruhen: (n) => { n.energy = Math.min(100, n.energy + 25); }, duschen: (n) => { n.hygiene = 100; },
      waschen: (n) => { n.hygiene = Math.min(100, n.hygiene + 30); }, arbeiten: (n) => { n.fun = Math.min(100, n.fun + 10); },
      lesen: (n) => { n.fun = Math.min(100, n.fun + 25); }, naschen: (n) => { n.hunger = Math.min(100, n.hunger + 35); },
      kochen: () => {}, essen: (n) => { n.hunger = 100; }, zeitung: (n) => { n.fun = Math.min(100, n.fun + 15); },
      fernsehen: (n) => { n.fun = Math.min(100, n.fun + 35); n.energy = Math.min(100, n.energy + 5); }, feuer: () => {}, tuer: () => {}, brief: () => {},
    };
    const TUN = DE ? {
      schlafen: 'legt sich schlafen.', musik: 'legt eine Platte auf.', basteln: 'bastelt an einer kleinen Drohne.', sterne: 'schaut durchs Fernrohr.',
      ausruhen: 'ruht sich aus.', duschen: 'geht duschen.', waschen: 'wäscht sich die Hände.', arbeiten: 'setzt sich an den Computer.',
      lesen: 'nimmt ein Buch aus dem Regal.', naschen: 'holt sich etwas aus dem Kühlschrank.', kochen: 'kocht etwas.', essen: 'isst.',
      zeitung: 'liest die Dorfzeitung.', fernsehen: 'schaut fern.', feuer: 'macht Feuer im Kamin.', tuer: 'geht zur Tür.', brief: 'holt einen Brief.',
    } : {
      schlafen: 'goes to bed.', musik: 'puts on a record.', basteln: 'tinkers with a little drone.', sterne: 'looks through the telescope.',
      ausruhen: 'has a rest.', duschen: 'takes a shower.', waschen: 'washes its hands.', arbeiten: 'sits down at the computer.',
      lesen: 'takes a book from the shelf.', naschen: 'grabs a snack from the fridge.', kochen: 'cooks something.', essen: 'eats.',
      zeitung: 'reads the village paper.', fernsehen: 'watches TV.', feuer: 'lights the fireplace.', tuer: 'goes to the door.', brief: 'fetches a letter.',
    };

    // ---------------------------------------------------------------- Zustand
    const nacht0 = schlafenszeit();
    const man = {
      x: nacht0 ? 56 : 120, f: nacht0 ? 2 : 1, y: 0, dir: 1, n: { hunger: 70, energy: nacht0 ? 30 : 80, fun: 60, hygiene: 75 },
      ziel: null, tut: null, zeit: 0, laeuft: false, schritt: 0, klettern: null, warte: 0, folge: null,
    };
    man.y = FOOT[man.f];
    const welt = { licht: !nacht0 && tageszeit() !== 'tag' ? true : !nacht0, feuer: WETTER.temp !== null && WETTER.temp < 6 && tageszeit() !== 'tag', teller: false, tuerAuf: 0, brief: null, blitz: 0, kuehlAuf: 0, t: 0 };
    if (nacht0) { man.tut = O.bett; man.taetigkeit = 'schlafen'; man.zeit = DAUER.schlafen; }
    let blase = null; // { text, bis }

    // ---------------------------------------------------------------- Tagebuch und Sprechblasen
    const tagebuch = document.getElementById('haus-tagebuch');
    const uhrText = () => new Date().toLocaleTimeString(DE ? 'de-DE' : 'en-GB', { hour: '2-digit', minute: '2-digit' });
    function log(t) {
      const div = document.createElement('div');
      div.textContent = `${uhrText()} – ${t}`;
      tagebuch.prepend(div);
      while (tagebuch.children.length > 60) tagebuch.lastChild.remove();
    }
    const NAME = tr('Das Männchen', 'The figure');
    function sag(text, sek = 5) { blase = { text, bis: welt.t + sek }; log(DE ? `„${text}“` : `“${text}”`); }

    // ---------------------------------------------------------------- Termine (Dorfzeitung)
    const fmtTag = (iso) => new Date(iso + 'T12:00:00').toLocaleDateString(DE ? 'de-DE' : 'en-GB', { weekday: 'long', day: 'numeric', month: 'long' });
    function terminSatz() {
      if (!termine.length) return tr('In der Zeitung steht nichts Neues aus dem Dorf.', 'Nothing new from the village in the paper.');
      const t = termine[Math.floor(Math.random() * Math.min(3, termine.length))];
      return tr(`Am ${fmtTag(t.tag)}: ${t.titel}${t.ort ? ' – ' + t.ort : ''}.`, `On ${fmtTag(t.tag)}: ${t.titel}.`);
    }

    // ---------------------------------------------------------------- Sätze
    function wetterSatz() {
      const temp = WETTER.temp !== null ? tr(` Draußen sind ${WETTER.temp} Grad.`, ` It's ${WETTER.temp} degrees outside.`) : '';
      const s = {
        klar: tr('Schönes Wetter heute!', 'Lovely weather today!'), wolkig: tr('Ein paar Wolken über dem Vogelsberg.', 'A few clouds over the Vogelsberg.'),
        bedeckt: tr('Grau in grau heute.', 'Grey skies today.'), nebel: tr('Man sieht kaum das Nachbarhaus vor Nebel.', 'So foggy I can hardly see next door.'),
        niesel: tr('Es nieselt. Gut, dass ich drinnen bin.', "It's drizzling. Glad I'm indoors."), regen: tr('Es regnet. Gut, dass ich drinnen bin.', "It's raining. Glad I'm indoors."),
        schnee: tr('Es schneit! Alles wird weiß.', "It's snowing! Everything's turning white."), gewitter: tr('Huch, ein Gewitter!', 'Whoa, a thunderstorm!'),
      }[WETTER.art];
      return s + temp;
    }
    function launeSatz() {
      const n = man.n, k = Object.entries(n).sort((a, b) => a[1] - b[1])[0];
      if (k[1] > 60) return tr('Mir geht es prima, danke!', "I'm doing great, thanks!");
      return {
        hunger: tr('Ganz gut, aber ich habe Hunger.', "Not bad, but I'm hungry."), energy: tr('Ich bin ziemlich müde.', "I'm pretty tired."),
        fun: tr('Mir ist ein bisschen langweilig.', "I'm a bit bored."), hygiene: tr('Ich sollte mal duschen.', 'I could use a shower.'),
      }[k[0]];
    }
    function plauderSatz() {
      const tz = schlafenszeit() ? 'nacht' : tageszeit() === 'nacht' ? 'abend' : tageszeit(), r = Math.random();
      if (r < 0.3) return wetterSatz();
      if (r < 0.45 && termine.length) return terminSatz();
      if (r < 0.6) return launeSatz();
      const s = DE ? {
        morgen: ['Guten Morgen, Stockhausen!', 'Erst mal einen Kaffee.'], tag: ['Was mache ich heute noch?', 'Hier ist es gemütlich.', 'Die Fenster könnte ich auch mal putzen.'],
        abend: ['Was für ein Abendhimmel!', 'Bald wird es dunkel.'], nacht: ['Wie ruhig es nachts im Dorf ist.', 'Eigentlich sollte ich schlafen.'],
      } : {
