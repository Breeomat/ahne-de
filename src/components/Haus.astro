        welt.teller = true; welt.gast = true; log(tr('Du stellst ein Essen auf den Tisch.', 'You put a meal on the table.'));
        aufwecken(tr('Riecht das nach Essen?', 'Do I smell food?')); geheZu(O.tisch, 'essen');
      } else if (a === 'licht') {
        welt.licht = !welt.licht; log(welt.licht ? tr('Du machst das Licht an.', 'You turn the light on.') : tr('Du machst das Licht aus.', 'You turn the light off.'));
        if (welt.licht) { if (!aufwecken(tr('Hey, ich wollte schlafen!', 'Hey, I was sleeping!')) && tageszeit() === 'tag') sag(tr('Licht am Tag? Na gut.', 'Lights during the day? Fine.')); }
        else if (schlafenszeit()) { sag(tr('Dann gehe ich wohl schlafen. Gute Nacht!', "Guess it's bedtime then. Good night!")); geheZu(O.bett); }
        else sag(tr('Wer hat das Licht ausgemacht?', 'Who turned off the light?'));
      } else if (a === 'klopfen') {
        log(tr('Du klopfst an die Haustür.', 'You knock on the front door.'));
        aufwecken(tr('Wer klopft denn da?', "Who's knocking?")); man.klopfer = true; man.tut = null; man.taetigkeit = null;
        man.ziel = { f: 1, x: 36, o: null, tun: 'tuer' };
      } else if (a === 'brief') {
        briefForm.hidden = !briefForm.hidden; if (!briefForm.hidden) document.getElementById('haus-brief-text').focus();
      } else if (a === 'zeitung') {
        zeitung.hidden = !zeitung.hidden;
      }
    }));
    briefForm.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const feld = document.getElementById('haus-brief-text'), text = feld.value.trim();
      if (!text) return;
      feld.value = ''; briefForm.hidden = true;
      welt.brief = text; welt.briefFall = welt.t; welt.briefAmKuehl = true;
      log(tr('Dein Brief fällt durch den Briefschlitz.', 'Your letter drops through the letter slot.'));
      aufwecken(tr('Post? Um diese Zeit?', 'Mail? At this hour?'));
      man.ziel = { f: 1, x: 38, o: null, tun: 'brief' };
      man.tut = null; man.taetigkeit = null;
    });
    // Plaudern: alle 25–45 s etwas sagen (nicht im Schlaf)
    let naechstesPlaudern = 6;
    function plaudern() {
      if (welt.t < naechstesPlaudern) return;
      naechstesPlaudern = welt.t + 25 + Math.random() * 20;
      if (man.taetigkeit === 'schlafen' || (blase && welt.t < blase.bis)) return;
      sag(plauderSatz());
    }

    // ---------------------------------------------------------------- Schleife
    let last = performance.now();
    function frame(now) {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      if (!reduziert) { update(dt); plaudern(); }
      else welt.t += dt;
      bild();
      g.imageSmoothingEnabled = false;
      g.drawImage(buf, 0, 0, W * S, H * S);
      schrift();
      hud();
      requestAnimationFrame(frame);
    }
    log(nacht0 ? tr('Das Männchen schläft. Pssst!', 'The figure is asleep. Shhh!') : tr('Das Männchen ist wach.', 'The figure is awake.'));
    if (!nacht0) setTimeout(() => sag(wetterSatz()), 1200);
    requestAnimationFrame(frame);
  </script>
