---
// „Haus-Männchen“ – öffentliches Zuschauerspiel im Pixel-Stil (/haus/, /en/house/). Eigener Entwurf.
// Ein dreistöckiges Haus im Querschnitt, ein Männchen mit Bedürfnissen (Hunger, Energie, Spaß, Hygiene),
// das seinen Tag selbst lebt: kocht, isst, liest, sieht fern, bastelt, duscht, schläft – mit Sprechblasen.
// Mitmachen: Gegenstände anklicken, Essen hinstellen, Licht, Anklopfen, Brief schreiben (Antwort aus festen Sätzen,
// nichts wird gesendet oder gespeichert).
// Stockhausen: Uhrzeit und Sonnenstand des Besuchers, echtes Wetter (src/data/wetter.json wie beim Drohnenflug),
// Blick aus den Fenstern aufs Dorf, Dorfzeitung (nur unter dem Bild, das Männchen nennt keine Termine) mit den Terminen von stockhausen-online (src/data/termine.json,
// scripts/termine.mjs im Workflow). Test: ?wetter=klar|wolkig|bedeckt|nebel|niesel|regen|schnee|gewitter,
// ?zeit=nacht|morgen|tag|abend.
// Grafik: Puffer 320×240 in ganzen Pixeln, ohne Glättung 3× vergrößert; Schrift (Raumnamen, Sprechblasen) wird
// scharf auf der großen Leinwand gezeichnet.
import Basis from '../layouts/Basis.astro';
import type { Sprache } from '../lib/sprache';
import wetter from '../data/wetter.json';
import termineDaten from '../data/termine.json';
import { url } from '../lib/site';

interface Props {
  sprache: Sprache;
}
const { sprache } = Astro.props;
const de = sprache === 'de';
const termine = (termineDaten as { termine?: { tag: string; titel: string; ort?: string }[] }).termine ?? [];
const texte = de
  ? {
      titel: 'Haus-Männchen',
      beschreibung: 'Herr Hausmann und seine Katze Minka in ihrem Haus in Stockhausen. Zusehen, Gegenstände anklicken oder mitmachen.',
      hinweis: 'Klick auf einen Gegenstand, dann geht Herr Hausmann dorthin. „Heranzoomen“ folgt ihm von Raum zu Raum. Fernrohr und Plattenspieler öffnen ein kleines Extra, am Computer läuft ein Video. Wetter, Uhrzeit, Sterne und Feiertage sind echt.',
      brummi: 'Brummi rufen', foto: 'Foto machen', alarm: 'Feuerwehr-Alarm', raffer: 'Zeitraffer (1 Tag in 2 Min.)', rafferAus: 'Zeitraffer beenden',
      ton: 'Ton an', tonAus: 'Ton aus', musikTitel: 'Plattenspieler: Was soll laufen?', walzer: 'Walzer',
      keller: 'Im Keller laufen die beiden Wärmepumpen so, wie die echten gestern um diese Uhrzeit liefen. PV-Anlage und Stromspeicher sind simuliert (aus Sonnenstand und Wetter).', kellerLink: 'Echte Wärmepumpen-Daten',
      kalenderTitel: 'Jahreszeit und Feste', gMitmachen: 'Mitmachen', gKatze: 'Katze Minka', gExtras: 'Extras',
      feste: [['heute', 'Heute (echt)'], ['fruehling', 'Frühling'], ['sommer', 'Sommer'], ['herbst', 'Herbst'], ['winter', 'Winter'], ['advent', 'Advent'], ['nikolaus', 'Nikolaus'], ['weihnachten', 'Weihnachten'], ['silvester', 'Silvester'], ['ostern', 'Ostern'], ['halloween', 'Halloween']],
      besuchTitel: 'Besuch einladen',
      gaeste: [['post', 'Postbote'], ['paket', 'Paketbotin'], ['nachbar', 'Nachbar mit Hund'], ['kaffee', 'Kaffeebesuch'], ['nachbarin', 'Nachbarin mit Kuchen'], ['freund', 'Freund zum Essen'], ['pizza', 'Pizzabote'], ['klempner', 'Heizungsbauer'], ['feger', 'Schornsteinfeger'], ['kamerad', 'Feuerwehrkamerad'], ['wanderer', 'Wanderin'], ['kinder', 'Nachbarskinder']], schippen: 'Schnee schippen',
      sterneTitel: 'Blick durchs Fernrohr: Himmel über Stockhausen',
      chaos: 'Nicht drücken!', einkaufen: 'Einkaufen schicken', zoom: 'Heranzoomen', zoomAus: 'Ganzes Haus',
      essen: 'Essen hinstellen', licht: 'Licht an/aus', klopfen: 'Anklopfen', brief: 'Brief schreiben', zeitung: 'Dorfzeitung',
      futter: 'Katze füttern', knaeuel: 'Wollknäuel werfen',
      briefPlatz: 'Was möchtest du Herrn Hausmann schreiben?', senden: 'Einwerfen',
      briefHinweis: 'Der Brief bleibt in deinem Browser, nichts wird gesendet oder gespeichert.',
      zeitungTitel: 'Dorfzeitung Stockhausen', keineTermine: 'In den nächsten zwei Wochen stehen keine Termine im Kalender.',
      alleTermine: 'Alle Termine auf stockhausen-online.de',
      hunger: 'Hunger', energie: 'Energie', spass: 'Spaß', hygiene: 'Hygiene',
    }
  : {
      titel: 'House figure',
      beschreibung: 'Mr Hausmann and his cat Minka in their house in Stockhausen. Watch, click on objects or join in.',
      hinweis: 'Click an object and Mr Hausmann will go there. “Zoom in” follows him from room to room. The telescope and record player open a little extra; the computer plays a video. Weather, time, stars and holidays are real.',
      brummi: 'Call Brummi', foto: 'Take a photo', alarm: 'Fire brigade alarm', raffer: 'Time-lapse (1 day in 2 min)', rafferAus: 'Stop time-lapse',
      ton: 'Sound on', tonAus: 'Sound off', musikTitel: 'Record player: what shall we play?', walzer: 'Waltz',
      keller: 'In the cellar the two heat pumps run just as the real ones did at this time yesterday. The solar panels and battery are simulated (from sun position and weather).', kellerLink: 'Real heat pump data (German)',
      kalenderTitel: 'Season and holidays', gMitmachen: 'Join in', gKatze: 'Minka the cat', gExtras: 'Extras',
      feste: [['heute', 'Today (real)'], ['fruehling', 'Spring'], ['sommer', 'Summer'], ['herbst', 'Autumn'], ['winter', 'Winter'], ['advent', 'Advent'], ['nikolaus', 'St Nicholas'], ['weihnachten', 'Christmas'], ['silvester', "New Year's Eve"], ['ostern', 'Easter'], ['halloween', 'Halloween']],
      besuchTitel: 'Invite a visitor',
      gaeste: [['post', 'Postman'], ['paket', 'Parcel courier'], ['nachbar', 'Neighbour with dog'], ['kaffee', 'Coffee visit'], ['nachbarin', 'Neighbour with cake'], ['freund', 'Friend for dinner'], ['pizza', 'Pizza courier'], ['klempner', 'Heating engineer'], ['feger', 'Chimney sweep'], ['kamerad', 'Fellow firefighter'], ['wanderer', 'Hiker'], ['kinder', 'Neighbours’ children']], schippen: 'Shovel snow',
      sterneTitel: 'Through the telescope: the sky over Stockhausen',
      chaos: 'Do not press!', einkaufen: 'Send shopping', zoom: 'Zoom in', zoomAus: 'Whole house',
      essen: 'Serve a meal', licht: 'Lights on/off', klopfen: 'Knock', brief: 'Write a letter', zeitung: 'Village paper',
      futter: 'Feed the cat', knaeuel: 'Throw a ball of yarn',
      briefPlatz: 'What would you like to write to Mr Hausmann?', senden: 'Post it',
      briefHinweis: 'The letter stays in your browser; nothing is sent or stored.',
      zeitungTitel: 'Stockhausen village paper', keineTermine: 'No events in the calendar for the next two weeks.',
      alleTermine: 'All events on stockhausen-online.de (German)',
      hunger: 'Hunger', energie: 'Energy', spass: 'Fun', hygiene: 'Hygiene',
    };
---
<Basis sprache={sprache} seite="haus" titel={texte.titel} beschreibung={texte.beschreibung}>
  <section class="haus">
    <h1>{texte.titel}</h1>
    <p class="haus__intro">{texte.beschreibung}</p>
    <div class="haus__hud">
      <span id="haus-uhr"></span>
      <span id="haus-wetter"></span>
      <span id="haus-energie"></span>
      <span>{texte.hunger} <i class="haus__bar"><b id="haus-b-hunger"></b></i></span>
      <span>{texte.energie} <i class="haus__bar"><b id="haus-b-energy"></b></i></span>
      <span>{texte.spass} <i class="haus__bar"><b id="haus-b-fun"></b></i></span>
      <span>{texte.hygiene} <i class="haus__bar"><b id="haus-b-hygiene"></b></i></span>
    </div>
    <canvas id="haus-canvas" width="1280" height="960" aria-label={texte.beschreibung} role="img"></canvas>
    <div class="haus__steuerung">
      <div class="haus__gruppe">
        <p class="haus__gruppentitel">{texte.gMitmachen}</p>
        <div class="haus__aktionen">
          <button type="button" data-aktion="essen">{texte.essen}</button>
          <button type="button" data-aktion="licht">{texte.licht}</button>
          <button type="button" data-aktion="klopfen">{texte.klopfen}</button>
          <button type="button" data-aktion="brief">{texte.brief}</button>
          <button type="button" data-aktion="zeitung">{texte.zeitung}</button>
          <button type="button" data-aktion="einkaufen">{texte.einkaufen}</button>
        </div>
      </div>
      <div class="haus__gruppe">
        <p class="haus__gruppentitel">{texte.gKatze}</p>
        <div class="haus__aktionen">
          <button type="button" data-aktion="futter">{texte.futter}</button>
          <button type="button" data-aktion="knaeuel">{texte.knaeuel}</button>
        </div>
      </div>
      <div class="haus__gruppe haus__gruppe--breit">
        <p class="haus__gruppentitel">{texte.besuchTitel}</p>
        <div class="haus__aktionen">
          {texte.gaeste.map(([k, l]) => <button type="button" data-besuch={k}>{l}</button>)}
          <button type="button" data-besuch="schippen" hidden>{texte.schippen}</button>
        </div>
      </div>
      <div class="haus__gruppe">
        <p class="haus__gruppentitel">{texte.gExtras}</p>
        <div class="haus__aktionen">
          <button type="button" data-aktion="zoom" data-an={texte.zoom} data-aus={texte.zoomAus} aria-pressed="false">{texte.zoom}</button>
          <button type="button" data-aktion="alarm">{texte.alarm}</button>
          <button type="button" data-aktion="raffer" data-an={texte.raffer} data-aus={texte.rafferAus} aria-pressed="false">{texte.raffer}</button>
          <button type="button" data-aktion="brummi">{texte.brummi}</button>
          <button type="button" data-aktion="foto">{texte.foto}</button>
          <button type="button" data-aktion="chaos" class="haus__verboten">{texte.chaos}</button>
          <button type="button" data-aktion="ton" data-an={texte.ton} data-aus={texte.tonAus} aria-pressed="false">{texte.ton}</button>
        </div>
      </div>
      <div class="haus__gruppe haus__gruppe--breit">
        <p class="haus__gruppentitel">{texte.kalenderTitel}</p>
        <div class="haus__aktionen">
          {texte.feste.map(([k, l]) => <button type="button" data-fest={k}>{l}</button>)}
        </div>
      </div>
    </div>
    <form class="haus__brief" id="haus-brief" hidden>
      <label for="haus-brief-text">{texte.briefPlatz}</label>
      <div>
        <input id="haus-brief-text" maxlength="120" autocomplete="off" />
        <button type="submit">{texte.senden}</button>
      </div>
      <small>{texte.briefHinweis}</small>
    </form>
    <section class="haus__zeitung" id="haus-zeitung" hidden>
      <h2>{texte.zeitungTitel}</h2>
      {termine.length === 0 && <p>{texte.keineTermine}</p>}
      {termine.length > 0 && (
        <ul>
          {termine.map((t) => (
            <li>
              <b>{new Date(t.tag + 'T12:00:00').toLocaleDateString(de ? 'de-DE' : 'en-GB', { weekday: 'short', day: '2-digit', month: '2-digit' })}</b>
              {' '}{t.titel}{t.ort ? ` – ${t.ort}` : ''}
            </li>
          ))}
        </ul>
      )}
      <p><a href="https://stockhausen-online.de/termine/">{texte.alleTermine}</a></p>
    </section>
    <section class="haus__panel" id="haus-musik" hidden>
      <h2>{texte.musikTitel}</h2>
      <div class="haus__aktionen">
        <button type="button" data-musik="rock">Rock</button>
        <button type="button" data-musik="walzer">{texte.walzer}</button>
        <button type="button" data-musik="disco">Disco</button>
      </div>
    </section>
    <section class="haus__panel" id="haus-sterne" hidden>
      <h2>{texte.sterneTitel}</h2>
      <canvas id="haus-sterne-canvas" width="480" height="480"></canvas>
      <p id="haus-sterne-text"></p>
    </section>
    <p class="haus__hinweis"><small>{texte.hinweis} {texte.keller} <a href={url('waermepumpe/')}>{texte.kellerLink}</a></small></p>
    <div id="haus-tagebuch" class="haus__tagebuch" aria-live="polite"></div>
  </section>
  <script define:vars={{ sprache, wetter }}>
    const DE = sprache === 'de';
    const tr = (d, e) => (DE ? d : e);
    const cv = document.getElementById('haus-canvas');
    const g = cv.getContext('2d');
    // Spielkoordinaten 320×240, gezeichnet wird viermal so fein (1280×960, Viertelpixel), angezeigt 1:1
    const W = 320, H = 240, F = 4, S = 4;
    const buf = document.createElement('canvas');
    buf.width = W * F; buf.height = H * F;
    let b = buf.getContext('2d');
    b.setTransform(F, 0, 0, F, 0, 0);
    const reduziert = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const params = new URLSearchParams(location.search);

    // ---------------------------------------------------------------- Farben (16er-Retro-Palette, leicht abgedunkelt)
    const C = {
      schwarz: '#101014', weiss: '#F0F0E8', rot: '#A8402E', dunkelrot: '#6E2A1E', ziegel: '#8E4A30', fuge: '#6A3422',
      gruen: '#4E9A44', dunkelgruen: '#2E5E2A', blau: '#3A4AB8', hellblau: '#7AB4E8', cyan: '#7ACCD0', gelb: '#E8D850',
      orange: '#D8843A', braun: '#6B4226', dunkelbraun: '#4A2C16', grau: '#8C8C8C', hellgrau: '#C0C0C0', dunkelgrau: '#4C4C50',
      haut: '#E8B890', haar: '#5A3418', hemd: '#C84A3A', hose: '#2E3A6E', schuh: '#2A1A10', lila: '#8A4AA8',
    };

    // ---------------------------------------------------------------- Zeichen-Helfer (ganze Pixel)
    const halb = (v) => Math.round(v * F) / F;
    const R = (x, y, w, h, c) => { b.fillStyle = c; b.fillRect(halb(x), halb(y), Math.max(1 / F, halb(w)), Math.max(1 / F, halb(h))); };
    const P = (x, y, c) => R(x, y, 1, 1, c);
    const Q = (x, y, c) => R(x, y, 0.5, 0.5, c); // halber Pixel
    // Kasten mit Licht oben/links und Schatten unten/rechts (wirkt plastisch)
    const K = (x, y, w, h, c, hell, dunkel) => { R(x, y, w, h, c); R(x, y, w, 0.5, hell); R(x, y, 0.5, h, hell); R(x, y + h - 0.5, w, 0.5, dunkel); R(x + w - 0.5, y, 0.5, h, dunkel); };
    const poly = (pts, c) => { b.fillStyle = c; b.beginPath(); pts.forEach(([x, y], i) => (i ? b.lineTo(x, y) : b.moveTo(x, y))); b.closePath(); b.fill(); };

    // ---------------------------------------------------------------- Uhrzeit, Sonnenstand, Wetter
    const RAFFER = { an: false, t0: 0, h0: 6, dauer: 120 }; // Zeitraffer: 24 Stunden in 120 Sekunden Spielzeit
    let spielzeit = 0; // Sekunden seit dem Start (wird in der Schleife hochgezählt)
    function stunde() {
      if (RAFFER.an) return (RAFFER.h0 + (spielzeit - RAFFER.t0) * 24 / RAFFER.dauer) % 24;
      const z = params.get('zeit');
      if (z) return { nacht: 1, morgen: 7.2, tag: 12, abend: 17.5 }[z] ?? 12;
      const d = new Date();
      return d.getHours() + d.getMinutes() / 60;
    }
    // Sonnenauf- und -untergang für Stockhausen (50,56° N, 9,44° O), einfache Näherung, Ortszeit des Besuchers
    function sonne() {
      const d = new Date(), j = (Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - Date.UTC(d.getFullYear(), 0, 0)) / 864e5;
      const dekl = 23.44 * Math.sin((2 * Math.PI * (284 + j)) / 365) * Math.PI / 180, br = 50.56 * Math.PI / 180;
      const ha = Math.acos(Math.max(-1, Math.min(1, -Math.tan(br) * Math.tan(dekl)))) * 180 / Math.PI / 15;
      const mittag = 12 - 9.44 / 15 - d.getTimezoneOffset() / 60;
      return { auf: mittag - ha, unter: mittag + ha };
    }
    const SONNE = sonne();
    function tageszeit() {
      const h = stunde();
      if (h < SONNE.auf - 0.6 || h > SONNE.unter + 0.6) return 'nacht';
      if (h < SONNE.auf + 0.6) return 'morgen';
      if (h > SONNE.unter - 0.6) return 'abend';
      return 'tag';
    }
    // Schlafenszeit nach der Uhr (nicht nach dem Sonnenuntergang)
    const schlafenszeit = () => { const h = stunde(); return h >= 22.5 || h < 6.5; };
    function wetterArt(code) {
      if (code <= 1) return 'klar';
      if (code === 2) return 'wolkig';
      if (code === 3) return 'bedeckt';
      if (code === 45 || code === 48) return 'nebel';
      if (code >= 51 && code <= 57) return 'niesel';
      if ((code >= 61 && code <= 67) || (code >= 80 && code <= 82)) return 'regen';
      if ((code >= 71 && code <= 77) || code === 85 || code === 86) return 'schnee';
      if (code >= 95) return 'gewitter';
      return 'klar';
    }
    const WETTER = (() => {
      const test = params.get('wetter');
      let art = null, temp = null, wind = 8;
      if (wetter && wetter.start) {
        const jetzt = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Berlin', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hourCycle: 'h23' }).format(new Date());
        const i = Math.round((Date.parse(jetzt.replace(' ', 'T') + ':00Z') - Date.parse(wetter.start + 'Z')) / 3600000);
        if (i >= 0 && i < wetter.code.length) { art = wetterArt(wetter.code[i]); temp = wetter.temp[i]; wind = wetter.wind[i]; }
      }
      if (test) art = test;
      return { art: art || 'klar', echt: !!art, temp, wind };
    })();
    const NASS = ['regen', 'niesel', 'gewitter'].includes(WETTER.art);
    const SCHNEE = WETTER.art === 'schnee';
    const WETTERNAME = {
      klar: tr('klar', 'clear'), wolkig: tr('wolkig', 'cloudy'), bedeckt: tr('bedeckt', 'overcast'), nebel: tr('Nebel', 'fog'),
      niesel: tr('Niesel', 'drizzle'), regen: tr('Regen', 'rain'), schnee: tr('Schnee', 'snow'), gewitter: tr('Gewitter', 'thunderstorm'),
    };

    // ---------------------------------------------------------------- Kalender: Jahreszeiten und Feiertage (Test: ?datum=JJJJ-MM-TT)
    function ostersonntag(j) { // Gaußsche Osterformel (Meeus)
      const a = j % 19, b = Math.floor(j / 100), c = j % 100, d = Math.floor(b / 4), e = b % 4, f = Math.floor((b + 8) / 25), g = Math.floor((b - f + 1) / 3);
      const h = (19 * a + b - d - g + 15) % 30, i = Math.floor(c / 4), k = c % 4, l = (32 + 2 * e + 2 * i - h - k) % 7, m = Math.floor((a + 11 * h + 22 * l) / 451);
      const mon = Math.floor((h + l - 7 * m + 114) / 31), tag = ((h + l - 7 * m + 114) % 31) + 1;
      return new Date(j, mon - 1, tag, 12);
    }
    let MON, TAG, JAHR, MD, JAHRESZEIT, LAUBFALL;
    const FEST = {};
    // Kalender setzen: echtes Datum oder per Knopf/?datum= gewähltes
    function kalender(heute) {
      MON = heute.getMonth() + 1; TAG = heute.getDate(); JAHR = heute.getFullYear(); MD = MON * 100 + TAG;
      const tageBis = (d) => Math.round((d - new Date(JAHR, MON - 1, TAG, 12)) / 864e5);
      const zuOstern = tageBis(ostersonntag(JAHR));
      const heiligabend = new Date(JAHR, 11, 24, 12), vierterAdvent = new Date(JAHR, 11, 24 - heiligabend.getDay(), 12);
      const seitAdvent = -tageBis(new Date(vierterAdvent.getTime() - 21 * 864e5));
      Object.assign(FEST, {
        advent: seitAdvent >= 0 && MON >= 11 && MD <= 1223,
        kerzen: Math.max(0, Math.min(4, Math.floor(seitAdvent / 7) + 1)),
        weihnachten: MD >= 1224 || MD <= 106,
        geschenke: MD >= 1224 && MD <= 1226,
        silvester: MD === 1231 || (MD === 101 && stunde() < 3),
        neujahr: MD === 101,
        nikolaus: MD === 1206,
        halloween: MD >= 1025 && MD <= 1031,
        ostern: zuOstern <= 2 && zuOstern >= -1,
      });
      FEST.lichterkette = FEST.advent || FEST.weihnachten;
      JAHRESZEIT = MD >= 321 && MD <= 620 ? 'fruehling' : MD >= 621 && MD <= 922 ? 'sommer' : MD >= 923 && MD <= 1220 ? 'herbst' : 'winter';
      LAUBFALL = JAHRESZEIT === 'herbst' && MD <= 1130;
    }
    kalender((() => { const d = params.get('datum'); const t = d ? new Date(d + 'T12:00:00') : new Date(); return isNaN(t) ? new Date() : t; })());
    function festSatz() {
      if (FEST.silvester) return tr(stunde() < 3 && MD === 101 ? 'Frohes neues Jahr!' : 'Heute ist Silvester! Ich freue mich aufs Feuerwerk.', stunde() < 3 && MD === 101 ? 'Happy New Year!' : "It's New Year's Eve! I'm looking forward to the fireworks.");
      if (FEST.neujahr) return tr('Frohes neues Jahr, Stockhausen!', 'Happy New Year, Stockhausen!');
      if (FEST.geschenke) return tr('Frohe Weihnachten! Unter dem Baum liegen Geschenke.', 'Merry Christmas! There are presents under the tree.');
      if (FEST.weihnachten) return tr('Der Weihnachtsbaum leuchtet so schön.', 'The Christmas tree looks so pretty.');
      if (FEST.nikolaus) return tr('Heute ist Nikolaus! Mal sehen, was im Stiefel ist.', "It's St Nicholas Day! Let's see what's in the boot.");
      if (FEST.advent) return tr(FEST.kerzen === 1 ? 'Die erste Kerze am Adventskranz brennt.' : `Schon ${FEST.kerzen} Kerzen am Adventskranz!`, FEST.kerzen === 1 ? 'The first Advent candle is lit.' : `${FEST.kerzen} Advent candles already!`);
      if (FEST.halloween) return tr('Der Kürbis vor der Tür grinst schon.', 'The pumpkin by the door is grinning.');
      if (FEST.ostern) return tr('Frohe Ostern! Im Garten sind Eier versteckt.', 'Happy Easter! There are eggs hidden in the garden.');
      return {
        fruehling: tr('Der Baum im Garten blüht!', 'The tree in the garden is in blossom!'), sommer: tr('Herrlicher Sommer im Vogelsberg.', 'Lovely summer in the Vogelsberg.'),
        herbst: tr('Die Blätter werden bunt.', 'The leaves are turning.'), winter: tr('Draußen ist es winterlich.', "It's wintry outside."),
      }[JAHRESZEIT];
    }

    // ---------------------------------------------------------------- Wärmepumpen: echte Daten vom Vortag (Seite /waermepumpe/)
    // Die Seite enthält die Messwerte als JSON („var DD=…,ENDE=“). Gezeigt wird der Zustand gestern zur selben Uhrzeit.
    const WPDATEN = { ende: null, pumpen: null, fehler: false };
    const wpJetzt = { Master: null, Slave: null };
    fetch('/waermepumpe/').then((a) => a.text()).then((t) => {
      const i = t.indexOf('var DD='), j = t.indexOf(',ENDE=DD.ende', i);
      if (i < 0 || j < 0) throw new Error('keine Daten');
      const dd = JSON.parse(t.slice(i + 7, j)), api = dd.api[Object.keys(dd.api)[0]];
      WPDATEN.ende = dd.ende; WPDATEN.pumpen = api.pumpen;
