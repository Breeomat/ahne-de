---
// 404: Die Drohne hat sich verflogen – Signal verloren, Radar sucht, Rückkehr zur Basis (Startseite).
import Basis from '../layouts/Basis.astro';
import { url } from '../lib/site';
---
<Basis titel="Signal verloren · 404" beschreibung="Diese Seite gibt es nicht – die Drohne hat sich verflogen.">
  <div class="verflogen">
    <div class="radar" aria-hidden="true">
      <span class="radar__kreis"></span><span class="radar__kreis"></span><span class="radar__kreis"></span>
      <span class="radar__strahl"></span>
      <svg class="drohne404" viewBox="0 0 120 120">
        <g class="drohne404__arme"><line x1="30" y1="30" x2="90" y2="90" /><line x1="90" y1="30" x2="30" y2="90" /></g>
        {[[30, 30], [90, 30], [30, 90], [90, 90]].map(([x, y], i) => (
          <g transform={`translate(${x} ${y})`}>
            <circle r="17" class="drohne404__schutz" />
            <g class="drohne404__rotor" style={`animation-duration:${0.18 + i * 0.02}s`}><ellipse rx="15" ry="2.6" /><ellipse rx="15" ry="2.6" transform="rotate(90)" /></g>
            <circle r="3" class="drohne404__nabe" />
          </g>
        ))}
        <rect x="45" y="45" width="30" height="30" rx="8" class="drohne404__koerper" />
        <circle cx="60" cy="52" r="3" class="drohne404__led" />
      </svg>
    </div>

    <p class="verflogen__status"><span class="rec"></span>ERROR 404 · SIGNAL VERLOREN</p>
    <h1>Die Drohne hat sich verflogen.</h1>
    <p>Diese Seite gibt es hier nicht. Die Drohne kreist und sucht – am schnellsten geht es zurück zur Basis.</p>
    <p lang="en" class="verflogen__en">The drone got lost: this page does not exist.</p>

    <dl class="verflogen__werte" aria-hidden="true">
      <dt>GPS</dt><dd data-gps>--.---- N  -.---- E</dd>
      <dt>ALT</dt><dd>??? m</dd>
      <dt>BAT</dt><dd data-akku>12 %</dd>
    </dl>

    <p class="verflogen__knoepfe">
      <a class="knopf-gold" href={url('')}>Zurück zur Basis</a>
      <a class="knopf-leise" href={url('en/')} lang="en">Back to base</a>
    </p>
  </div>
</Basis>

<script>
  // Koordinaten suchen vergeblich, der Akku sinkt langsam
  const gps = document.querySelector<HTMLElement>('[data-gps]')!;
  const akku = document.querySelector<HTMLElement>('[data-akku]')!;
  let stand = 12;
  const ziffer = () => (Math.random() < 0.35 ? '-' : String(Math.floor(Math.random() * 10)));
  setInterval(() => {
    gps.textContent = `5${ziffer()}.${ziffer()}${ziffer()}${ziffer()}${ziffer()} N  ${ziffer()}.${ziffer()}${ziffer()}${ziffer()}${ziffer()} E`;
  }, 180);
  setInterval(() => {
    stand = Math.max(1, stand - 1);
    akku.textContent = `${stand} %`;
  }, 4000);
</script>

<style>
  .verflogen { display: grid; justify-items: center; text-align: center; gap: 0.4rem; padding-block: 1rem 3rem; }
  .verflogen h1 { font-size: clamp(2rem, 7vw, 3.4rem) !important; margin: 0.2rem 0 0.4rem; }
  .verflogen p { max-width: 34rem; margin: 0.2rem 0; }
  .verflogen__en { color: var(--text-leise); font-size: 0.95rem; }

  .verflogen__status {
    display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.2rem !important;
    font: 700 0.8rem ui-monospace, Menlo, Consolas, monospace; letter-spacing: 0.12em; color: #ff8f9c;
    animation: flackern404 2.4s steps(1) infinite;
  }
  .rec { width: 9px; height: 9px; border-radius: 50%; background: #ff4d61; box-shadow: 0 0 8px #ff4d61; }
  @keyframes flackern404 { 0%, 100% { opacity: 1; } 47% { opacity: 1; } 48% { opacity: 0.2; } 50% { opacity: 1; } 71% { opacity: 0.4; } 72% { opacity: 1; } }

  /* Radar mit kreisender Drohne */
  .radar { position: relative; width: min(300px, 75vw); aspect-ratio: 1; margin-top: 0.5rem; border-radius: 50%;
    background: radial-gradient(circle, rgb(159 245 220 / 0.07), rgb(159 245 220 / 0.02) 70%, transparent 71%);
    border: 1px solid rgb(159 245 220 / 0.35); overflow: hidden; }
  .radar__kreis { position: absolute; inset: 0; margin: auto; border-radius: 50%; border: 1px solid rgb(159 245 220 / 0.2); }
  .radar__kreis:nth-child(1) { width: 33%; height: 33%; }
  .radar__kreis:nth-child(2) { width: 66%; height: 66%; }
  .radar__kreis:nth-child(3) { width: 100%; height: 1px; border: 0; background: rgb(159 245 220 / 0.2); }
  .radar__strahl { position: absolute; inset: 0; border-radius: 50%;
    background: conic-gradient(from 0deg, rgb(159 245 220 / 0.45), rgb(159 245 220 / 0) 70deg, transparent 360deg);
    animation: sweep 3s linear infinite; }
  @keyframes sweep { to { rotate: 360deg; } }

  .drohne404 { position: absolute; left: 50%; top: 50%; width: 30%; translate: -50% -50%; filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.6));
    animation: verirrt 9s ease-in-out infinite; }
  @keyframes verirrt {
    0% { transform: translate(-60%, -40%) rotate(-20deg); }
    20% { transform: translate(55%, -55%) rotate(25deg); }
    40% { transform: translate(70%, 45%) rotate(160deg); }
    55% { transform: translate(-10%, 10%) rotate(200deg) scale(1.1); }
    75% { transform: translate(-75%, 50%) rotate(300deg); }
    100% { transform: translate(-60%, -40%) rotate(340deg); }
  }
  .drohne404__arme line { stroke: #6b7482; stroke-width: 7; stroke-linecap: round; }
  .drohne404__schutz { fill: rgb(10 12 24 / 0.35); stroke: #ffd76a; stroke-width: 1.5; }
  .drohne404__rotor { animation: rotor 0.2s linear infinite; }
  .drohne404__rotor ellipse { fill: rgb(220 230 240 / 0.55); }
  @keyframes rotor { to { rotate: 360deg; } }
  .drohne404__nabe { fill: #9aa3ad; }
  .drohne404__koerper { fill: #1a1d26; stroke: #ffd76a; stroke-width: 2; }
  .drohne404__led { fill: #ff4d61; animation: blinken 0.8s steps(1) infinite; }

  .verflogen__werte { display: grid; grid-template-columns: auto auto; gap: 0.1rem 0.8rem; margin: 0.8rem 0 0.4rem;
    font: 600 0.8rem ui-monospace, Menlo, Consolas, monospace; letter-spacing: 0.08em; color: #9ff5dc; text-align: left; }
  .verflogen__werte dt { opacity: 0.7; }
  .verflogen__werte dd { margin: 0; color: #eafff8; min-width: 14ch; }

  .verflogen__knoepfe { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; margin-top: 0.8rem !important; }
  .knopf-gold, .knopf-leise { padding: 0.6rem 1.2rem; border-radius: 999px; font-weight: 700; text-decoration: none; }
  .knopf-gold { background: var(--verlauf, #d4a63a); color: #1a1406 !important; }
  .knopf-leise { border: 1px solid rgb(242 210 122 / 0.5); color: #f2f0e8 !important; }

  @media (prefers-reduced-motion: reduce) {
    .radar__strahl, .drohne404, .drohne404__rotor, .verflogen__status, .drohne404__led { animation: none !important; }
  }
</style>
